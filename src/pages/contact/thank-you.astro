---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Thank You" description="Thanks for reaching out to Charrish Travels.">
  <section class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6">
    <h1 class="font-serif text-3xl text-emerald-950">Thanks for reaching out!</h1>
    <p class="mt-3 text-emerald-900/70">We've received your message and will get back to you within a day.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-emerald-700 px-6 py-3 text-sm font-semibold text-white hover:bg-emerald-800">
      Back to home
    </a>
  </section>
</Layout>
