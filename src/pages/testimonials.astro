---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import statsBackground from '../assets/stats-background.jpg';

const testimonials = await getCollection('testimonials');
const rendered = await Promise.all(testimonials.map((t) => render(t)));
const testimonialCards = testimonials.map((t, i) => ({ t, Content: rendered[i].Content }));
const columnA = testimonialCards.filter((_, i) => i % 2 === 0);
const columnB = testimonialCards.filter((_, i) => i % 2 === 1);
---

<Layout title="Testimonials & Reviews" description="What travellers say about Charrish Travels, plus leave your own review.">
  {/* max-w-7xl with the columns' own px-6 puts the content edge at the same
      distance from the viewport as the packages grid. */}
  <section class="mx-auto flex max-w-7xl flex-col lg:h-[calc(100svh-3rem)] lg:flex-row lg:gap-10">
    <div class="flex flex-col px-4 py-12 sm:px-6 sm:py-16 lg:w-3/5 lg:py-16">
      <h1 class="font-brand text-5xl text-emerald-950">Testimonials & Reviews</h1>

      <div class="mt-8 grid grid-cols-2 gap-4 overflow-hidden lg:h-full lg:flex-1">
        <div class="overflow-hidden lg:h-full">
          <div class="marquee-track flex flex-col gap-4">
            {[...columnA, ...columnA].map(({ t, Content }) => (
              <blockquote class="rounded-xl border border-gold-300/70 bg-cream p-4 shadow-sm">
                <div class="text-gold-500" aria-hidden="true">{'★'.repeat(t.data.rating)}{'☆'.repeat(5 - t.data.rating)}</div>
                <div class="mt-2 text-xs text-emerald-900/80 italic">
                  <Content />
                </div>
                <footer class="mt-4 text-xs font-semibold text-emerald-950">
                  {t.data.name}
                  {t.data.occupation && <span class="font-normal text-emerald-900/60"> · {t.data.occupation}</span>}
                </footer>
              </blockquote>
            ))}
          </div>
        </div>
        <div class="overflow-hidden lg:h-full">
          <div class="marquee-track marquee-track-reverse flex flex-col gap-4">
            {[...columnB, ...columnB].map(({ t, Content }) => (
              <blockquote class="rounded-xl border border-gold-300/70 bg-cream p-4 shadow-sm">
                <div class="text-gold-500" aria-hidden="true">{'★'.repeat(t.data.rating)}{'☆'.repeat(5 - t.data.rating)}</div>
                <div class="mt-2 text-xs text-emerald-900/80 italic">
                  <Content />
                </div>
                <footer class="mt-4 text-xs font-semibold text-emerald-950">
                  {t.data.name}
                  {t.data.occupation && <span class="font-normal text-emerald-900/60"> · {t.data.occupation}</span>}
                </footer>
              </blockquote>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="relative mx-4 mb-12 overflow-hidden rounded-xl px-4 py-8 sm:mx-6 sm:px-6 lg:mt-20 lg:mr-6 lg:mb-0 lg:ml-0 lg:w-2/5 lg:self-center-safe lg:px-8">
      <Image src={statsBackground} alt="" widths={[640, 1024, 1600]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover object-[30%_60%]" />
      <div class="absolute inset-0 bg-emerald-950/60"></div>

      <div class="relative flex flex-col">
        <h2 class="font-brand text-3xl text-white">Leave a review</h2>
        <form id="review-form" class="mt-4 space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="review-name" class="block text-xs font-medium text-white">Name</label>
              <input id="review-name" name="name" type="text" required maxlength="80" class="mt-1 w-full rounded-md border border-gold-300/70 bg-white px-3 py-2 text-xs focus:border-gold-500 focus:outline-none" />
            </div>
            <div>
              <label for="review-occupation" class="block text-xs font-medium text-white">Profession (optional)</label>
              <input id="review-occupation" name="occupation" type="text" maxlength="80" class="mt-1 w-full rounded-md border border-gold-300/70 bg-white px-3 py-2 text-xs focus:border-gold-500 focus:outline-none" />
            </div>
          </div>

          <div>
            <span class="block text-xs font-medium text-white">Rating</span>
            <div id="review-stars" class="mt-1 flex items-center gap-1" role="radiogroup" aria-label="Rating out of 5">
              {[1, 2, 3, 4, 5].map((value) => (
                <button
                  type="button"
                  data-star={value}
                  role="radio"
                  aria-checked={value === 5 ? 'true' : 'false'}
                  aria-label={`${value} star${value > 1 ? 's' : ''}`}
                  class="cursor-pointer p-1 text-2xl leading-none text-gold-400 transition-transform duration-150 hover:scale-110 active:scale-95"
                >
                  ★
                </button>
              ))}
              <span id="review-rating-label" class="ml-2 text-xs text-white/80">Excellent</span>
            </div>
            <input id="review-rating" name="rating" type="hidden" value="5" />
          </div>

          <div>
            <label for="review-message" class="block text-xs font-medium text-white">Your review</label>
            <textarea id="review-message" name="message" rows="4" required maxlength="1000" class="mt-1 w-full rounded-md border border-gold-300/70 bg-white px-3 py-2 text-xs focus:border-gold-500 focus:outline-none"></textarea>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div class="min-w-0 flex-1 sm:max-w-60">
              <label for="review-photo" class="block text-xs font-medium text-white">Add a photo (optional)</label>
              <input
                id="review-photo"
                name="photo"
                type="file"
                accept="image/png, image/jpeg, image/webp"
                class="mt-1 w-full rounded-md border border-gold-300/70 bg-white px-2 py-1 text-xs text-emerald-900 file:mr-3 file:rounded-full file:border-0 file:bg-emerald-800 file:px-3 file:py-1 file:text-xs file:font-semibold file:text-white hover:file:bg-emerald-900 focus:border-gold-500 focus:outline-none"
              />
            </div>
            <button
              type="submit"
              class="shrink-0 rounded-full bg-gold-500 px-6 py-3 sm:mr-3 sm:ml-auto text-xs font-semibold text-emerald-950 transition-all duration-200 hover:scale-105 hover:bg-gold-400 active:scale-95 disabled:opacity-60"
            >
              Submit review
            </button>
          </div>
          <p class="text-[11px] text-white/70">JPEG, PNG or WebP — up to 5MB.</p>
          <img id="review-photo-preview" alt="Preview of your uploaded photo" class="hidden h-24 w-24 rounded-lg object-cover" />
          <p id="review-photo-error" class="hidden text-[11px] text-red-200" role="alert"></p>
          <p id="review-status" class="text-xs text-white" role="status"></p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (min-width: 1024px) {
    .marquee-track {
      animation: marquee-up 40s linear infinite;
    }
    .marquee-track-reverse {
      animation-name: marquee-up;
      animation-duration: 50s;
    }
  }

  @keyframes marquee-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }
</style>

<script>
  const form = document.getElementById('review-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('review-status');
  const photoInput = document.getElementById('review-photo') as HTMLInputElement | null;
  const photoPreview = document.getElementById('review-photo-preview') as HTMLImageElement | null;
  const photoError = document.getElementById('review-photo-error');

  const MAX_PHOTO_BYTES = 5 * 1024 * 1024; // 5MB
  const ALLOWED_PHOTO_TYPES = new Set(['image/jpeg', 'image/png', 'image/webp']);

  // Interactive star rating -> writes into the hidden #review-rating input
  const starButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-star]'));
  const ratingInput = document.getElementById('review-rating') as HTMLInputElement | null;
  const ratingLabel = document.getElementById('review-rating-label');
  const RATING_WORDS: Record<number, string> = {
    1: 'Poor',
    2: 'Below average',
    3: 'Average',
    4: 'Good',
    5: 'Excellent',
  };

  function paintStars(value: number) {
    starButtons.forEach((btn) => {
      const v = Number(btn.dataset.star);
      const filled = v <= value;
      btn.textContent = filled ? '★' : '☆';
      btn.classList.toggle('text-gold-400', filled);
      btn.classList.toggle('text-white/50', !filled);
      btn.setAttribute('aria-checked', String(v === value));
    });
  }

  function setRating(value: number) {
    if (ratingInput) ratingInput.value = String(value);
    if (ratingLabel) ratingLabel.textContent = RATING_WORDS[value] ?? '';
    paintStars(value);
  }

  starButtons.forEach((btn) => {
    const value = Number(btn.dataset.star);
    btn.addEventListener('click', () => setRating(value));
    btn.addEventListener('mouseenter', () => paintStars(value));
    btn.addEventListener('focus', () => paintStars(value));
  });

  const starsWrap = document.getElementById('review-stars');
  starsWrap?.addEventListener('mouseleave', () => paintStars(Number(ratingInput?.value ?? 5)));

  if (starButtons.length) setRating(5);

  function resetPhotoField() {
    if (photoInput) photoInput.value = '';
    if (photoPreview) {
      photoPreview.src = '';
      photoPreview.classList.add('hidden');
    }
    if (photoError) {
      photoError.textContent = '';
      photoError.classList.add('hidden');
    }
  }

  function showPhotoError(message: string) {
    resetPhotoField();
    if (photoError) {
      photoError.textContent = message;
      photoError.classList.remove('hidden');
    }
  }

  photoInput?.addEventListener('change', () => {
    const file = photoInput.files?.[0];
    if (photoError) {
      photoError.textContent = '';
      photoError.classList.add('hidden');
    }
    if (!file) {
      photoPreview?.classList.add('hidden');
      return;
    }
    if (!ALLOWED_PHOTO_TYPES.has(file.type)) {
      showPhotoError('Please choose a JPEG, PNG or WebP image.');
      return;
    }
    if (file.size > MAX_PHOTO_BYTES) {
      showPhotoError('That photo is too large — please choose one under 5MB.');
      return;
    }
    if (photoPreview) {
      photoPreview.src = URL.createObjectURL(file);
      photoPreview.classList.remove('hidden');
    }
  });

  function readFileAsDataUrl(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result));
      reader.onerror = () => reject(reader.error);
      reader.readAsDataURL(file);
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    const photoFile = photoInput?.files?.[0] ?? null;
    if (photoFile && (!ALLOWED_PHOTO_TYPES.has(photoFile.type) || photoFile.size > MAX_PHOTO_BYTES)) {
      showPhotoError('Please fix the photo above before submitting.');
      return;
    }

    if (submitButton) submitButton.disabled = true;
    if (statusEl) statusEl.textContent = 'Submitting…';

    const formData = new FormData(form);
    const payload: Record<string, unknown> = {
      name: String(formData.get('name') ?? '').trim(),
      occupation: String(formData.get('occupation') ?? '').trim(),
      rating: Number(formData.get('rating')),
      message: String(formData.get('message') ?? '').trim(),
    };

    try {
      if (photoFile) {
        const dataUrl = await readFileAsDataUrl(photoFile);
        const base64 = dataUrl.slice(dataUrl.indexOf(',') + 1);
        payload.photo = base64;
        payload.photoType = photoFile.type;
      }

      const res = await fetch('/.netlify/functions/submit-review', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('Submission failed');

      form.reset();
      resetPhotoField();
      if (starButtons.length) setRating(5);
      if (statusEl) statusEl.textContent = 'Thanks! Your review is pending approval and will appear here once published.';
    } catch {
      if (statusEl) statusEl.textContent = 'Something went wrong — please try again.';
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
