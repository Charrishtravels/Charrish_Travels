---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { SITE } from '../consts';
import agraTajMahal from '../assets/hero/agra-taj-mahal.jpg';
import sicilyCefalu from '../assets/hero/sicily-cefalu.jpg';
import jaipur from '../assets/hero/jaipur.jpg';
import theanHouLanterns from '../assets/hero/thean-hou-lanterns.jpg';
import dubai from '../assets/hero/dubai.jpg';
import palaceCourtyard from '../assets/hero/palace-courtyard.jpg';
import maldives from '../assets/hero/maldives.jpg';
import prague from '../assets/hero/prague.jpg';
import tempioDiErcole from '../assets/hero/tempio-di-ercole.jpg';
import vaticanRome from '../assets/hero/vatican-rome.jpg';
import heritageTourOfIndia from '../assets/heritage-tour-of-india.jpg';
import mentonFrance from '../assets/hero/menton-france.jpg';

const columnA = [
  { src: agraTajMahal, alt: 'Taj Mahal, Agra', h: 'h-72' },
  { src: sicilyCefalu, alt: 'Cefalù coastline, Sicily', h: 'h-56' },
  { src: jaipur, alt: 'Streets of Jaipur', h: 'h-80' },
  { src: theanHouLanterns, alt: 'Lanterns at Thean Hou Temple', h: 'h-64' },
  { src: dubai, alt: 'Dubai skyline', h: 'h-72' },
  { src: palaceCourtyard, alt: 'Palace courtyard', h: 'h-60' },
];

const columnB = [
  { src: maldives, alt: 'Overwater villas, Maldives', h: 'h-64' },
  { src: prague, alt: 'Charles Bridge at sunset, Prague', h: 'h-80' },
  { src: tempioDiErcole, alt: 'Temple of Hercules, Sicily', h: 'h-56' },
  { src: vaticanRome, alt: 'Aerial view of Vatican City, Rome', h: 'h-72' },
  { src: heritageTourOfIndia, alt: 'Heritage tour of India', h: 'h-64' },
  { src: mentonFrance, alt: 'Coastal town of Menton, France', h: 'h-80' },
];
---

<Layout title="About Us" description={`The story behind ${SITE.name}.`} hideFooter>
  <section class="flex flex-col lg:h-[calc(100svh-3rem)] lg:flex-row">
    <div class="flex flex-col justify-center px-4 py-12 sm:px-6 sm:py-16 lg:w-2/5 lg:py-16 lg:pl-12">
      <h1 class="font-brand text-5xl leading-[1.05] text-emerald-950">
        Our story
      </h1>

      <div class="mt-6 max-w-md space-y-4 text-xs text-black">
        <p>
          {SITE.name} started with a simple idea: we put together itineraries the way we'd plan a trip
          for our own family — good stays, honest pricing, and no surprises once you've landed.
        </p>
        <p>
          Every package on this site has been travelled and vetted by our team before it's listed.
          Where something can be tailored — dates, group size, add-ons — we'll always tell you.
        </p>
        <p>
          Based out of {SITE.location}, we work with travellers across India looking for everything
          from quick weekend escapes to longer guided trips.
        </p>
        <p>
          Most of what we plan is close to home — hill stations, backwaters, heritage cities, and
          coastal getaways across India — alongside a smaller set of international routes we know
          well enough to vouch for personally.
        </p>
      </div>

      <a
        href="/destinations"
        class="mt-8 inline-flex w-fit items-center gap-2 rounded-full bg-emerald-800 px-6 py-3 text-xs font-semibold text-white transition-all duration-200 hover:scale-105 hover:bg-emerald-900 active:scale-95"
      >
        View our packages
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid grid-cols-2 gap-4 overflow-hidden px-4 py-8 sm:px-6 lg:h-full lg:w-3/5 lg:gap-6 lg:px-8 lg:py-0">
      <div class="marquee-col overflow-hidden lg:h-full">
        <div class="marquee-track flex flex-col gap-4 lg:gap-6">
          {[...columnA, ...columnA].map((img) => (
            <Image
              src={img.src}
              alt={img.alt}
              widths={[240, 400, 600]}
              sizes="(min-width: 1024px) 280px, 45vw"
              loading="lazy"
              class:list={['w-full rounded-2xl object-cover shadow-sm', img.h]}
            />
          ))}
        </div>
      </div>
      <div class="marquee-col overflow-hidden lg:h-full">
        <div class="marquee-track marquee-track-reverse flex flex-col gap-4 lg:gap-6">
          {[...columnB, ...columnB].map((img) => (
            <Image
              src={img.src}
              alt={img.alt}
              widths={[240, 400, 600]}
              sizes="(min-width: 1024px) 280px, 45vw"
              loading="lazy"
              class:list={['w-full rounded-2xl object-cover shadow-sm', img.h]}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:py-20">
    <h2 class="font-brand text-3xl text-emerald-950">Why travel with us</h2>
    <div class="mt-8 grid gap-8 sm:grid-cols-3">
      <div>
        <h3 class="font-brand text-lg text-emerald-950">Travelled, not just listed</h3>
        <p class="mt-2 text-xs text-black">
          Someone from our team has been to every stay and route on this site before it's offered to
          you — we don't resell packages we haven't checked ourselves.
        </p>
      </div>
      <div>
        <h3 class="font-brand text-lg text-emerald-950">One quote, no surprises</h3>
        <p class="mt-2 text-xs text-black">
          The price we send is the price you pay. If something's optional or chargeable on the ground,
          we say so upfront instead of leaving it for check-in day.
        </p>
      </div>
      <div>
        <h3 class="font-brand text-lg text-emerald-950">A person to call</h3>
        <p class="mt-2 text-xs text-black">
          Every booking comes with a direct line to our team over call or WhatsApp — before you leave,
          while you're travelling, and if plans change last minute.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (min-width: 1024px) {
    .marquee-track {
      animation: marquee-up 45s linear infinite;
    }
    .marquee-track-reverse {
      animation-name: marquee-up;
      animation-duration: 55s;
    }
  }

  @keyframes marquee-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }
</style>
