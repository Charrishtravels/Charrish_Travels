---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import RouteWatermark from '../components/RouteWatermark.astro';
import { SITE } from '../consts';

import southIndianTempleTank from '../assets/hero/south-indian-temple-tank.jpg';
import watArunBangkok from '../assets/hero/wat-arun-bangkok.jpg';
import hawaMahalJaipur from '../assets/hero/hawa-mahal-jaipur.jpg';
import swissAlpineVillage from '../assets/hero/swiss-alpine-village.jpg';
import dubai from '../assets/hero/dubai.jpg';
import maldives from '../assets/hero/maldives.jpg';
import himalayanSnowPass from '../assets/hero/himalayan-snow-pass.jpg';
import rockCutTempleHall from '../assets/hero/rock-cut-temple-hall.jpg';
import heritageTourOfIndia from '../assets/heritage-tour-of-india.jpg';

// 8-point compass star matching the logo's star mark.
const STAR_PATH =
  'M10 0 L10.77 8.15 L14.24 5.76 L11.85 9.23 L20 10 L11.85 10.77 L14.24 14.24 L10.77 11.85 L10 20 L9.23 11.85 L5.76 14.24 L8.15 10.77 L0 10 L8.15 9.23 L5.76 5.76 L9.23 8.15 Z';

const PROCESS = [
  {
    n: '01',
    title: 'We listen first',
    body: 'Who is travelling, what the trip is for, the pace that suits you, the budget you have in mind, and the things you would rather not do.',
  },
  {
    n: '02',
    title: 'We draft a route',
    body: 'A first itinerary with real distances, honest travel times and stays chosen for where you actually need to be each night.',
  },
  {
    n: '03',
    title: 'We reshape it with you',
    body: 'Cut what does not excite you. We swap, re-pace and rebalance until the plan reads like your trip rather than ours.',
  },
  {
    n: '04',
    title: 'We arrange everything',
    body: 'Vehicles, hotels, guides, visas, darshan assistance and the logistics between them — booked and confirmed before you leave.',
  },
  {
    n: '05',
    title: 'We stay reachable',
    body: 'One point of contact from the first message to your return, so a change of plan on the road is a phone call, not a problem.',
  },
];

const PHOTOS = [
  { src: dubai, alt: 'Burj Al Arab at dusk, Dubai' },
  { src: maldives, alt: 'Overwater villas, Maldives' },
  { src: swissAlpineVillage, alt: 'Wooden chalets beneath a Swiss alpine peak' },
  { src: hawaMahalJaipur, alt: 'Hawa Mahal, Jaipur' },
  { src: southIndianTempleTank, alt: 'South Indian temple tank and gopuram at dusk' },
  { src: watArunBangkok, alt: 'Wat Arun at sunset, Bangkok' },
  { src: himalayanSnowPass, alt: 'Snow-covered Himalayan mountain pass' },
  { src: rockCutTempleHall, alt: 'Sunlit pillared hall of a rock-cut temple' },
  { src: heritageTourOfIndia, alt: 'Heritage tour of India' },
];

const HEIGHTS = ['h-44', 'h-56', 'h-40', 'h-52', 'h-48'];

// Six columns of four photos each, every column starting at a different point in
// the list so neighbouring columns never show the same photo side by side.
// Columns 4–6 only appear at wider breakpoints.
const COLUMNS = Array.from({ length: 6 }, (_, c) =>
  Array.from({ length: 4 }, (_, r) => ({
    ...PHOTOS[(c * 3 + r * 2) % PHOTOS.length],
    h: HEIGHTS[(c + r) % HEIGHTS.length],
  })),
);
const COLUMN_VISIBILITY = ['', '', '', 'hidden sm:block', 'hidden lg:block', 'hidden lg:block'];
---

<Layout title="About Us" description={`The story behind ${SITE.name}.`}>
  <section class="relative isolate overflow-hidden">
    {/* Scrolling photo wall behind the arch; alternate columns run in opposite
        directions. Washed with cream so the arch stays the focal point. */}
    <div class="absolute inset-0 -z-10 grid grid-cols-3 gap-3 px-3 sm:grid-cols-4 lg:grid-cols-6 lg:gap-4" aria-hidden="true">
      {COLUMNS.map((column, i) => (
        <div class:list={['overflow-hidden', COLUMN_VISIBILITY[i]]}>
          <div
            class:list={['about-wall-track flex flex-col gap-3 lg:gap-4', i % 2 === 1 && 'about-wall-track-reverse']}
            style={`animation-duration: ${46 + i * 5}s`}
          >
            {[...column, ...column].map((img) => (
              <Image
                src={img.src}
                alt=""
                widths={[240, 400]}
                sizes="(min-width: 1024px) 16vw, (min-width: 640px) 25vw, 33vw"
                loading="lazy"
                class:list={['w-full rounded-2xl object-cover', img.h]}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="absolute inset-0 -z-10 bg-page/45"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-page to-transparent"></div>

    {/* Arched doorway, nodding to temple and palace gateways. */}
    <div class="px-4 pt-14 pb-20 sm:px-6 sm:pt-20 sm:pb-24">
      <div class="relative mx-auto w-full max-w-sm sm:max-w-md" data-reveal="zoom">
        <div class="absolute -inset-3 rounded-t-full border-2 border-b-0 border-temple-gold sm:-inset-4"></div>
        {/* Threshold: joins the outline's two legs and runs past them on wider
            screens, so the arch stands on a floor instead of stopping in mid-air. */}
        <div class="absolute -inset-x-3 -bottom-3 h-0.5 bg-temple-gold sm:-inset-x-24 sm:-bottom-4 sm:bg-gradient-to-r sm:from-transparent sm:via-temple-gold sm:to-transparent"></div>
        <div class="relative flex flex-col items-center rounded-t-full bg-sand px-8 pt-24 pb-12 text-center shadow-2xl sm:pt-28 sm:pb-14">
          <svg viewBox="0 0 20 20" class="h-7 w-7 text-temple-gold" aria-hidden="true">
            <path d={STAR_PATH} fill="currentColor" />
          </svg>
          <h1 class="font-brand mt-5 text-3xl leading-[1.15] text-earth sm:text-4xl">
            Travel should feel personal, not packaged.
          </h1>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
    {/* The opening line runs the full measure rather than a half column, so it
        breaks two or three times instead of five. */}
    <div data-reveal="up">
      <p class="font-brand max-w-5xl text-2xl leading-snug text-earth sm:text-3xl">
        {SITE.name} was built with a simple belief — every journey deserves thoughtful planning,
        honest communication, and dedicated support.
      </p>

      <div class="mt-10">
        <div class="max-w-[62ch] space-y-4 border-l-2 border-temple-gold/60 pl-5 text-xs leading-relaxed text-ink-muted sm:text-sm">
          <p>
            From family holidays and honeymoon trips to group tours, pilgrimage journeys, and
            international vacations, we create personalized travel experiences based on your needs,
            budget, and preferences.
          </p>
          <p>
            Based in Hyderabad, we help travellers explore destinations across India and beyond, with
            support for accommodation, transportation, sightseeing, guided experiences, and visa
            assistance.
          </p>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
          <p class="inline-flex items-center gap-2 text-xs font-medium text-maroon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
              <path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
            Hyderabad, India
          </p>
          <a
            href="/tours"
            class="inline-flex w-fit items-center gap-2 rounded-full bg-saffron px-6 py-3 text-xs font-semibold text-on-saffron transition-all duration-200 hover:scale-105 hover:bg-saffron-deep active:scale-95"
          >
            View our tours
            <span class="text-on-saffron/70" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Customisation is the core service, so it takes the page's navy band. What
      keeps it readable is the structure, not the background: one column at a
      comfortable measure, the process as full-width rows, and larger type than
      the light sections use, since body copy on dark needs the extra size. */}
  <section class="relative overflow-hidden bg-sand px-4 py-16 text-earth sm:px-6 lg:py-24">
    <RouteWatermark />
    <div class="relative mx-auto max-w-7xl">
      <div data-reveal="up">
        <h2 class="font-brand text-3xl leading-tight sm:text-4xl lg:text-5xl">
          Every itinerary starts as an empty page
        </h2>
        {/* Side by side rather than one narrow column, so the copy fills the band
            without any line running long. */}
        <div class="mt-8 grid gap-8 text-sm leading-relaxed text-ink-muted sm:text-base lg:grid-cols-2 lg:gap-14">
          <p class="max-w-[62ch]">
            Most agencies begin with a finished package and look for travellers to fill it. We began
            the other way round, because the trips people told us about afterwards were never the
            ones printed in a brochure. They were the morning the family reached the temple before
            the crowds. The afternoon nobody rushed anyone. The evening a driver knew a quieter road
            home.
          </p>
          <p class="max-w-[62ch]">
            Those moments don't survive a fixed departure. They come from knowing who is travelling —
            a grandparent who needs the shorter walk, a couple who would rather see one city slowly
            than four in a blur, a group of ten who want to stay together without moving as one
            block. So we stopped selling packages and started building itineraries, one at a time,
            around the people taking them.
          </p>
        </div>
      </div>

      {/* The journey line and the closing quote share the width, so neither the
          steps nor the band end up with an empty half. */}
      <div class="mt-16 grid gap-14 lg:mt-20 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-16">
      <ol class="relative border-l border-line pl-10 sm:pl-14">
        {PROCESS.map((step) => (
          <li class="relative pb-11 last:pb-0" data-reveal="up">
            <span class="font-brand absolute top-0 -left-[3.3rem] flex h-9 w-9 items-center justify-center rounded-full border border-temple-gold/70 bg-card text-sm text-temple-gold sm:-left-[4.4rem] sm:h-11 sm:w-11 sm:text-base">
              {step.n}
            </span>
            <h3 class="font-brand text-xl leading-snug text-earth sm:text-2xl">{step.title}</h3>
            <p class="mt-2.5 max-w-[62ch] text-sm leading-relaxed text-ink-muted sm:text-base">{step.body}</p>
          </li>
        ))}
      </ol>

      <aside
        class="rounded-2xl bg-card px-6 py-8 sm:px-8 lg:sticky lg:top-24 lg:self-start"
        data-reveal="up"
      >
        <blockquote class="border-l-2 border-temple-gold pl-5">
          <p class="font-brand text-xl leading-snug text-earth">
            A fixed package asks you to adapt to it. A tailored one adapts to you — and that is the
            difference between a holiday you took and a holiday that was yours.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-ink-muted">
            It costs us more time. It is also the only way we know how to do this well.
          </p>
        </blockquote>
        <a
          href={`https://wa.me/${SITE.whatsapp}`}
          target="_blank"
          rel="noopener"
          class="mt-7 ml-5 inline-flex w-fit items-center gap-2 rounded-full bg-saffron px-6 py-3 text-xs font-semibold text-on-saffron transition-all duration-200 hover:scale-105 hover:bg-saffron-deep active:scale-95"
        >
          Tell us about your trip
        </a>
      </aside>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-24">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-line bg-card p-6 sm:p-8" data-reveal="up">
        <svg viewBox="0 0 20 20" class="h-5 w-5 text-saffron" aria-hidden="true">
          <path d={STAR_PATH} fill="currentColor" />
        </svg>
        <h2 class="font-brand mt-4 text-2xl text-earth">More than just a booking</h2>
        <p class="mt-3 text-xs leading-relaxed text-ink-muted sm:text-sm">
          From planning to your return, our team stays connected to make your journey smooth and
          stress-free. We take care of the details so you can focus on creating unforgettable
          memories.
        </p>
      </div>

      <div class="flex flex-col rounded-2xl bg-sand p-6 sm:p-8" data-reveal="up" style="--reveal-delay: 120ms">
        <svg viewBox="0 0 20 20" class="h-5 w-5 text-temple-gold" aria-hidden="true">
          <path d={STAR_PATH} fill="currentColor" />
        </svg>
        <h2 class="font-brand mt-4 text-2xl text-earth">Our promise</h2>
        <p class="mt-3 text-xs leading-relaxed text-ink-muted sm:text-sm">
          Your journey is more than a booking. It’s an experience we’re proud to help you create.
        </p>
        <p class="font-brand mt-auto pt-5 text-sm tracking-[0.15em] text-saffron-deep uppercase">Your journey. Our care.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-wall-track {
    animation: about-wall-up linear infinite;
  }

  .about-wall-track-reverse {
    animation-direction: reverse;
  }

  @keyframes about-wall-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-wall-track {
      animation: none;
    }
  }
</style>
