---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import { SITE, TOUR_CATEGORIES } from '../../consts';
import himalayanSnowPass from '../../assets/hero/himalayan-snow-pass.jpg';
import southIndianTempleTank from '../../assets/hero/south-indian-temple-tank.jpg';
import watArunBangkok from '../../assets/hero/wat-arun-bangkok.jpg';

export async function getStaticPaths() {
  const destinations = await getCollection('destinations');
  return TOUR_CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      tours: destinations.filter((d) => d.data.category === category.slug),
    },
  }));
}

const { category, tours } = Astro.props;

// A photograph per category, so the three pages don't open identically.
const HEADER_IMAGES = {
  domestic: himalayanSnowPass,
  temple: southIndianTempleTank,
  international: watArunBangkok,
};

// 8-point compass star matching the logo's star mark.
const STAR_PATH =
  'M10 0 L10.77 8.15 L14.24 5.76 L11.85 9.23 L20 10 L11.85 10.77 L14.24 14.24 L10.77 11.85 L10 20 L9.23 11.85 L5.76 14.24 L8.15 10.77 L0 10 L8.15 9.23 L5.76 5.76 L9.23 8.15 Z';
---

<Layout title={category.label} description={category.blurb}>
  <section class="relative isolate overflow-hidden py-16 sm:py-20 lg:py-24">
    <Image
      src={HEADER_IMAGES[category.slug]}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-page/90 via-page/65 via-45% to-transparent"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6" data-reveal="up">
      <h1 class="font-brand text-5xl leading-tight text-earth sm:text-6xl">{category.label}</h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-muted sm:text-base">{category.blurb}</p>

      <ul class="mt-8 flex flex-wrap gap-2.5">
        {category.traits.map((trait) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-card px-3.5 py-2 text-xs text-ink-muted">
            <svg viewBox="0 0 20 20" class="h-3 w-3 shrink-0 text-temple-gold" aria-hidden="true">
              <path d={STAR_PATH} fill="currentColor" />
            </svg>
            {trait}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20">
    {tours.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tours.map((destination, i) => (
          <div data-reveal="up" style={`--reveal-delay: ${(i % 3) * 110}ms`}>
            <DestinationCard destination={destination} orientation="landscape" />
          </div>
        ))}
      </div>
    ) : (
      <div class="mx-auto max-w-2xl text-center" data-reveal="up">
        <svg viewBox="0 0 20 20" class="mx-auto h-7 w-7 text-saffron" aria-hidden="true">
          <path d={STAR_PATH} fill="currentColor" />
        </svg>
        <h2 class="font-brand mt-5 text-3xl text-earth sm:text-4xl">Nothing on the shelf yet</h2>
        <p class="mt-4 text-sm leading-relaxed text-ink-muted sm:text-base">
          Which is rather the point. We don't keep {category.label.toLowerCase()} sitting in a
          brochure waiting for someone to fit into them — we start with where you want to go, who is
          travelling and when, and build the itinerary from there.
        </p>
        <a
          href={`https://wa.me/${SITE.whatsapp}`}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-saffron px-7 py-3 text-xs font-semibold text-on-saffron transition-all duration-200 hover:scale-105 hover:bg-saffron-deep active:scale-95"
        >
          Tell us where you'd like to go
        </a>
        <p class="mt-4 text-xs text-ink-muted">Usually a reply the same day.</p>
      </div>
    )}
  </section>
</Layout>
