---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import { SITE, TOUR_CATEGORIES } from '../../consts';

export async function getStaticPaths() {
  const destinations = await getCollection('destinations');
  return TOUR_CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      tours: destinations.filter((d) => d.data.category === category.slug),
    },
  }));
}

const { category, tours } = Astro.props;
---

<Layout title={category.label} description={category.blurb}>
  <section class="bg-navy-800 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="text-[11px] font-semibold tracking-[0.2em] text-gold-400 uppercase">
        <a href="/tours" class="hover:text-gold-300">Tours</a>
      </p>
      <h1 class="font-brand mt-2 text-5xl text-white">{category.label}</h1>
      <p class="mt-3 max-w-2xl text-xs text-gold-300 sm:text-sm lg:max-w-none">{category.blurb}</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
    {tours.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tours.map((destination, i) => (
          <div data-reveal="up" style={`--reveal-delay: ${(i % 3) * 110}ms`}>
            <DestinationCard destination={destination} orientation="landscape" />
          </div>
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-emerald-800/25 px-6 py-14 text-center" data-reveal="up">
        <h2 class="font-brand text-2xl text-gold-950">Built to order</h2>
        <p class="mx-auto mt-3 max-w-md text-xs leading-relaxed text-black/70 sm:text-sm">
          We don't keep fixed {category.label.toLowerCase()} on the shelf. Tell us where you'd like
          to go, who's travelling and when — we'll plan it around you from scratch.
        </p>
        <a
          href={`https://wa.me/${SITE.whatsapp}`}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-gold-500 px-6 py-3 text-xs font-semibold text-gold-950 transition-all duration-200 hover:scale-105 hover:bg-gold-400 active:scale-95"
        >
          Start a conversation
        </a>
      </div>
    )}
  </section>
</Layout>
