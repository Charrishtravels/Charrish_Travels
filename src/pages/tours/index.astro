---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import { SITE, TOUR_CATEGORIES } from '../../consts';

const destinations = await getCollection('destinations');
const groups = TOUR_CATEGORIES.map((category) => ({
  ...category,
  tours: destinations.filter((d) => d.data.category === category.slug),
}));
---

<Layout title="Tours" description="Domestic, temple and international tours from Charrish Travels — every one built around you.">
  <section class="bg-navy-800 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h1 class="font-brand text-5xl text-white">Tours</h1>
      <p class="mt-3 max-w-2xl text-xs text-gold-300 sm:text-sm lg:max-w-none">
        Every tour below is a starting point, not a fixed package — tell us your dates, pace and
        group, and we build the itinerary around them.
      </p>
    </div>
  </section>

  {groups.map((group) => (
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal="up">
        <div>
          <h2 class="font-brand text-3xl text-gold-950 sm:text-4xl">{group.label}</h2>
          <p class="mt-2 max-w-xl text-xs text-black/70 sm:text-sm">{group.blurb}</p>
        </div>
        {group.tours.length > 0 && (
          <a href={`/tours/${group.slug}`} class="text-xs font-semibold text-emerald-800 underline decoration-gold-400/60 underline-offset-4 hover:text-emerald-900">
            View all {group.label.toLowerCase()}
          </a>
        )}
      </div>

      {group.tours.length > 0 ? (
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {group.tours.map((destination, i) => (
            <div data-reveal="up" style={`--reveal-delay: ${(i % 3) * 110}ms`}>
              <DestinationCard destination={destination} orientation="landscape" />
            </div>
          ))}
        </div>
      ) : (
        <div class="mt-8 rounded-2xl border border-dashed border-emerald-800/25 px-6 py-10 text-center" data-reveal="up">
          <p class="text-xs text-black/70 sm:text-sm">
            We're putting these itineraries together. Tell us where you'd like to go and we'll build
            one around you.
          </p>
          <a
            href={`https://wa.me/${SITE.whatsapp}`}
            target="_blank"
            rel="noopener"
            class="mt-5 inline-flex items-center gap-2 rounded-full bg-gold-500 px-6 py-3 text-xs font-semibold text-gold-950 transition-all duration-200 hover:scale-105 hover:bg-gold-400 active:scale-95"
          >
            Plan this trip with us
          </a>
        </div>
      )}
    </section>
  ))}
</Layout>
