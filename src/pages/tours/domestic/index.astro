---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import DestinationCard from '../../../components/DestinationCard.astro';
import RegionCard from '../../../components/RegionCard.astro';
import ContactButtons from '../../../components/ContactButtons.astro';
import CustomiseNote from '../../../components/CustomiseNote.astro';
import { SITE } from '../../../consts';
import {
  states,
  unionTerritories,
  allRegions,
  regionHref,
} from '../../../data/india';
import heroPhoto from '../../../assets/hero/himalayan-snow-pass.jpg';

const packages = (await getCollection('destinations')).filter((d) => d.data.category === 'domestic');
const destinationCount = allRegions.reduce((n, r) => n + r.destinations.length, 0);
const zones = [...new Set(allRegions.map((r) => r.zone))].sort();

const title = 'Domestic Tours – Explore All 28 States & 8 Union Territories of India';
const description = `Custom India holidays across all 28 states and 8 union territories — ${destinationCount}+ destinations, temples and pilgrimage sites, and tailor-made packages from ${SITE.name}, Hyderabad.`;
const ogImage = (await getImage({ src: heroPhoto, width: 1200, format: 'jpg' })).src;

const pageUrl = new URL('/tours/domestic', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Domestic Tours – India destination directory',
      url: pageUrl,
      description,
      publisher: { '@type': 'TravelAgency', name: SITE.name, telephone: SITE.phone, url: Astro.site?.href },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
        { '@type': 'ListItem', position: 2, name: 'Domestic Tours', item: pageUrl },
      ],
    },
    {
      '@type': 'ItemList',
      name: 'Indian states and union territories',
      numberOfItems: allRegions.length,
      itemListElement: [...states, ...unionTerritories].map((r, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: r.name,
        url: new URL(regionHref(r.slug), Astro.site).href,
      })),
    },
  ],
};

---

<Layout title={title} description={description} image={ogImage} whatsappMessage={"Hi Charrish Travels, I'd like help planning a holiday in India."}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {/* Hero */}
  <section class="relative isolate overflow-hidden py-16 sm:py-20 lg:py-24">
    <Image src={heroPhoto} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-page/95 via-page/75 via-50% to-page/20"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6" data-reveal="up">
      <h1 class="font-brand max-w-3xl text-4xl leading-tight text-earth sm:text-6xl">
        Explore every corner of India
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-muted sm:text-base">
        All 28 states and 8 union territories, A to Z — with the temples and places worth visiting
        in each. Pick a state, and we'll build the trip around your dates, pace and people.
      </p>

      <dl class="mt-7 flex flex-wrap gap-x-8 gap-y-3">
        <div><dt class="sr-only">States</dt><dd class="font-brand text-3xl text-earth">28 <span class="font-sans text-xs text-ink-muted">states</span></dd></div>
        <div><dt class="sr-only">Union territories</dt><dd class="font-brand text-3xl text-earth">8 <span class="font-sans text-xs text-ink-muted">union territories</span></dd></div>
        <div><dt class="sr-only">Destinations</dt><dd class="font-brand text-3xl text-earth">{destinationCount}+ <span class="font-sans text-xs text-ink-muted">destinations</span></dd></div>
      </dl>

    </div>
  </section>

  {packages.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20" aria-labelledby="packages-heading">
      <h2 id="packages-heading" class="font-brand text-3xl text-earth sm:text-4xl" data-reveal="up">Ready-made domestic packages</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {packages.map((d) => (
          <div data-reveal="up"><DestinationCard destination={d} orientation="landscape" /></div>
        ))}
      </div>
    </section>
  )}

  {/* Wrapper bounds the sticky bar: it stops sticking once the directory ends. */}
  <div>
  {/* Directory controls: search and zone filter. Sticky under the nav. */}
  <div id="directory" class="z-30 border-y lg:sticky lg:top-12 border-line bg-page/95 backdrop-blur">
    <div class="mx-auto flex max-w-7xl flex-col gap-2.5 px-4 py-3 sm:px-6 lg:flex-row lg:items-center lg:gap-6">
      <label class="relative block lg:w-72">
        <span class="sr-only">Search states or destinations</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-ink-muted" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" /></svg>
        <input type="search" data-directory-search placeholder="Search state or place, e.g. Munnar" class="w-full rounded-full border border-line bg-card py-2 pr-4 pl-9 text-sm text-ink placeholder:text-ink-muted/70 focus:border-saffron focus:outline-none" />
      </label>
      <div class="-mx-4 flex gap-1.5 overflow-x-auto px-4 [scrollbar-width:none] max-lg:[mask-image:linear-gradient(to_right,black_85%,transparent)] lg:mx-0 lg:px-0" role="group" aria-label="Filter by region">
        <button type="button" data-zone-filter="" aria-pressed="true" class="zone-chip">All</button>
        {zones.map((z) => <button type="button" data-zone-filter={z} aria-pressed="false" class="zone-chip">{z}</button>)}
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 pt-10 sm:px-6">
    <CustomiseNote text="Every state below is a starting point. Combine states, mix temples with sightseeing, choose your days and hotels — we build the trip around your family, pace and budget." />
  </div>

  {/* States */}
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16" aria-labelledby="states-heading" data-directory-section>
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="states-heading" class="font-brand text-3xl text-earth sm:text-4xl">All 28 states of India</h2>
      </div>
      <p class="text-xs text-ink-muted" data-directory-count></p>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {states.map((r) => <RegionCard region={r} />)}
    </div>
    <p class="hidden py-10 text-center text-sm text-ink-muted" data-directory-empty>No states match — try another name.</p>
  </section>

  {/* Union territories */}
  <section class="border-t border-line bg-sand/60" aria-labelledby="uts-heading" data-directory-section>
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-[10px] font-semibold tracking-[0.2em] text-saffron-deep uppercase">Islands, capitals and the high Himalaya</p>
          <h2 id="uts-heading" class="font-brand mt-2 text-3xl text-earth sm:text-4xl">All 8 union territories</h2>
        </div>
        <p class="text-xs text-ink-muted" data-directory-count></p>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {unionTerritories.map((r) => <RegionCard region={r} />)}
      </div>
      <p class="hidden py-10 text-center text-sm text-ink-muted" data-directory-empty>No union territories match.</p>
    </div>
  </section>

  </div>

  {/* Contact band */}
  <section class="bg-earth py-12 sm:py-16">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="text-on-dark">
        <h2 class="font-brand text-3xl sm:text-4xl">Not sure where to start?</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-on-dark-muted">
          Tell us the month, who's travelling and what you enjoy — temples, mountains, beaches,
          wildlife, food — and we'll suggest the states that fit and a route that works.
        </p>
        <ul class="mt-5 space-y-1.5 text-sm text-on-dark-muted">
          <li>✓ Every itinerary customised, never a fixed package</li>
          <li>✓ Chauffeur-driven cars, hotels and guides arranged</li>
          <li>✓ One planner on WhatsApp from first message to return</li>
        </ul>
      </div>
      <ContactButtons tone="dark" message="Hi Charrish Travels, I'd like help planning a holiday in India." />
    </div>
  </section>

  {/* Photo credits, required by the Creative Commons licences */}
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <details class="text-[11px] text-ink-muted">
      <summary class="cursor-pointer hover:text-saffron-deep">Photo credits</summary>
      <ul class="mt-3 columns-1 gap-6 sm:columns-2 lg:columns-3">
        {allRegions.map((r) => ({ label: r.name, credit: r.credit })).map(({ label, credit }) => (
          <li class="mb-1 break-inside-avoid">
            {label}: <a href={credit.sourceUrl} target="_blank" rel="noopener nofollow" class="underline">{credit.artist}</a>,{' '}
            {credit.licenseUrl ? <a href={credit.licenseUrl} target="_blank" rel="noopener nofollow" class="underline">{credit.license}</a> : credit.license}, via Wikimedia Commons
          </li>
        ))}
      </ul>
    </details>
  </section>
</Layout>

<style>
  .zone-chip {
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-card);
    padding: 0.375rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-earth);
    transition: background-color 150ms, color 150ms, border-color 150ms;
  }
  .zone-chip:hover {
    border-color: var(--color-temple-gold);
  }
  .zone-chip[aria-pressed='true'] {
    background: var(--color-saffron);
    border-color: var(--color-saffron);
    color: var(--color-on-saffron);
  }
</style>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-directory-search]')!;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-zone-filter]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-directory-section]'));
  let zone = '';

  const apply = () => {
    const q = search.value.trim().toLowerCase();
    for (const section of sections) {
      const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-region-card]'));
      let shown = 0;
      for (const card of cards) {
        const match = (!zone || card.dataset.zone === zone) && (!q || card.dataset.search!.includes(q));
        card.hidden = !match;
        if (match) shown++;
      }
      const filtered = q || zone;
      section.querySelector('[data-directory-count]')!.textContent = filtered ? `${shown} of ${cards.length} shown` : '';
      section.querySelector('[data-directory-empty]')!.classList.toggle('hidden', shown > 0);
    }
  };

  search.addEventListener('input', apply);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      zone = chip.dataset.zoneFilter!;
      for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
      apply();
    });
  }
</script>
