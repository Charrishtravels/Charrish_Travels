---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import DestinationCard from '../../../components/DestinationCard.astro';
import ContactButtons from '../../../components/ContactButtons.astro';
import CountryCard from '../../../components/CountryCard.astro';
import CustomiseNote from '../../../components/CustomiseNote.astro';
import { SITE } from '../../../consts';
import { countries, countriesByContinent, countryHref } from '../../../data/world';
import heroPhoto from '../../../assets/hero/swiss-alpine-village.jpg';

const ready = (await getCollection('destinations')).filter((d) => d.data.category === 'international');

// Every place listed on the country pages: sightseeing plus temples and sacred sites.
const placesIn = (list: typeof countries) =>
  list.reduce((n, c) => n + (c.details ? c.details.destinations.length + c.details.devotional.length : c.places.length), 0);
const destinationCount = placesIn(countries);

const title = `International Tours – Explore ${countries.length} Countries Worldwide`;
const description = `Custom international holidays from Hyderabad: ${countries.length} countries and ${destinationCount}+ destinations across Asia, the Middle East, Europe, Africa, Australia and the Americas — places to visit, temples and fully customisable trips from ${SITE.name}.`;
const ogImage = (await getImage({ src: heroPhoto, width: 1200, format: 'jpg' })).src;

const pageUrl = new URL('/tours/international', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'International Tours – world destination directory',
      url: pageUrl,
      description,
      publisher: { '@type': 'TravelAgency', name: SITE.name, telephone: SITE.phone, url: Astro.site?.href },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
        { '@type': 'ListItem', position: 2, name: 'International Tours', item: pageUrl },
      ],
    },
    {
      '@type': 'ItemList',
      name: 'International destinations',
      numberOfItems: countries.length,
      itemListElement: countries.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        url: new URL(countryHref(c.slug), Astro.site).href,
      })),
    },
  ],
};
---

<Layout title={title} description={description} image={ogImage} whatsappMessage={"Hi Charrish Travels, I'd like help planning an international holiday."}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {/* Hero */}
  <section class="relative isolate overflow-hidden py-16 sm:py-20 lg:py-24">
    <Image src={heroPhoto} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-page/95 via-page/75 via-50% to-page/20"></div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6" data-reveal="up">
      <h1 class="font-brand max-w-3xl text-4xl leading-tight text-earth sm:text-6xl">Explore the world, your way</h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-muted sm:text-base">
        {countries.length} countries across {countriesByContinent.length} continents — with the places worth visiting and the temples and
        sacred sites in each. Pick a country, and we'll build the trip around your dates, pace and people.
      </p>
      <dl class="mt-7 flex flex-wrap gap-x-8 gap-y-3">
        <div><dt class="sr-only">Countries</dt><dd class="font-brand text-3xl text-earth">{countries.length} <span class="font-sans text-xs text-ink-muted">countries</span></dd></div>
        <div><dt class="sr-only">Continents</dt><dd class="font-brand text-3xl text-earth">{countriesByContinent.length} <span class="font-sans text-xs text-ink-muted">continents</span></dd></div>
        <div><dt class="sr-only">Destinations</dt><dd class="font-brand text-3xl text-earth">{destinationCount}+ <span class="font-sans text-xs text-ink-muted">destinations</span></dd></div>
      </dl>
    </div>
  </section>

  <div>
    <div class="mx-auto max-w-7xl px-4 pt-10 sm:px-6">
      <CustomiseNote text="Every country below is a starting point. Combine countries — Dubai with Turkey, Singapore with Bali, Switzerland with Paris — choose your days, hotels and meals, and we'll handle the route, visas and stays." />
    </div>

    {/* Directory controls: search and zone filter. Scrolls inline with the page. */}
    <div id="directory" class="mt-10 border-y border-line bg-page">
      <div class="mx-auto flex max-w-7xl flex-col gap-2.5 px-4 py-3 sm:px-6 lg:flex-row lg:items-center lg:gap-6">
        <label class="relative block lg:w-72 lg:shrink-0">
          <span class="sr-only">Search countries or places</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-ink-muted" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" /></svg>
          <input type="search" data-directory-search placeholder="Search country or place, e.g. Bali" class="w-full rounded-full border border-line bg-card py-2 pr-4 pl-9 text-sm text-ink placeholder:text-ink-muted/70 focus:border-saffron focus:outline-none" />
        </label>
        <div class="-mx-4 flex gap-1.5 overflow-x-auto px-4 [scrollbar-width:none] max-lg:[mask-image:linear-gradient(to_right,black_85%,transparent)] lg:mx-0 lg:flex-wrap lg:overflow-visible lg:px-0" role="group" aria-label="Filter by continent">
          <button type="button" data-zone-filter="" aria-pressed="true" class="zone-chip">All</button>
          {countriesByContinent.map((g) => <button type="button" data-zone-filter={g.continent} aria-pressed="false" class="zone-chip">{g.continent}</button>)}
        </div>
      </div>
    </div>

    {countriesByContinent.map((g, gi) => (
      <section id={g.slug} class:list={['scroll-mt-28', gi % 2 === 1 && 'border-y border-line bg-sand/60']} aria-labelledby={`${g.slug}-heading`} data-directory-section>
        <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-14">
          <div class="flex flex-wrap items-end justify-between gap-2">
            <h2 id={`${g.slug}-heading`} class="font-brand text-3xl text-earth sm:text-4xl">{g.continent}</h2>
            <p class="text-xs text-ink-muted" data-directory-count data-default-count={`${g.countries.length} countries · ${placesIn(g.countries)} destinations`}>{g.countries.length} countries · {placesIn(g.countries)} destinations</p>
          </div>
          <div class="mt-7 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {g.countries.map((c) => <CountryCard country={c} />)}
          </div>
        </div>
      </section>
    ))}
    <p class="mx-auto hidden max-w-7xl px-4 py-16 text-center text-sm text-ink-muted" data-directory-empty>No countries match — try another name, or ask us on WhatsApp.</p>
  </div>

  {ready.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pb-14 sm:px-6 sm:pb-16" aria-labelledby="ready-heading">
      <h2 id="ready-heading" class="font-brand text-3xl text-earth sm:text-4xl">Departures with set itineraries</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {ready.map((d) => <div><DestinationCard destination={d} orientation="landscape" /></div>)}
      </div>
    </section>
  )}

  {/* Contact band */}
  <section class="bg-earth py-12 sm:py-16">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="text-on-dark">
        <h2 class="font-brand text-3xl sm:text-4xl">Don't see your destination?</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-on-dark-muted">
          We plan trips well beyond this list. Tell us where, when and who's travelling — we'll handle the visa paperwork, flights, hotels and transfers.
        </p>
        <ul class="mt-5 space-y-1.5 text-sm text-on-dark-muted">
          <li>✓ Visa paperwork handled for you</li>
          <li>✓ Airport transfers booked both ends</li>
          <li>✓ Indian vegetarian meals arranged on request</li>
        </ul>
      </div>
      <ContactButtons tone="dark" message="Hi Charrish Travels, I'd like help planning an international holiday." />
    </div>
  </section>

  {/* Photo credits, required by the Creative Commons licences */}
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <details class="text-[11px] text-ink-muted">
      <summary class="cursor-pointer hover:text-saffron-deep">Photo credits</summary>
      <ul class="mt-3 columns-1 gap-6 sm:columns-2 lg:columns-3">
        {countries.map((c) => (
          <li class="mb-1 break-inside-avoid">
            {c.name}: <a href={c.credit.sourceUrl} target="_blank" rel="noopener nofollow" class="underline">{c.credit.artist}</a>,{' '}
            {c.credit.licenseUrl ? <a href={c.credit.licenseUrl} target="_blank" rel="noopener nofollow" class="underline">{c.credit.license}</a> : c.credit.license}, via Wikimedia Commons
          </li>
        ))}
      </ul>
    </details>
  </section>
</Layout>

<style>
  .zone-chip {
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-card);
    padding: 0.375rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-earth);
    white-space: nowrap;
    transition: background-color 150ms, color 150ms, border-color 150ms;
  }
  .zone-chip:hover {
    border-color: var(--color-temple-gold);
  }
  .zone-chip[aria-pressed='true'] {
    background: var(--color-saffron);
    border-color: var(--color-saffron);
    color: var(--color-on-saffron);
  }
</style>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-directory-search]')!;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-zone-filter]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-directory-section]'));
  const empty = document.querySelector<HTMLElement>('[data-directory-empty]')!;
  let zone = '';

  const apply = () => {
    const q = search.value.trim().toLowerCase();
    let total = 0;
    for (const section of sections) {
      const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-region-card]'));
      let shown = 0;
      for (const card of cards) {
        const match = (!zone || card.dataset.zone === zone) && (!q || card.dataset.search!.includes(q));
        card.hidden = !match;
        if (match) shown++;
      }
      // A region with no matches disappears rather than leaving an empty block.
      section.hidden = shown === 0;
      const count = section.querySelector('[data-directory-count]')!;
      count.textContent = q || zone ? `${shown} of ${cards.length} shown` : (count as HTMLElement).dataset.defaultCount!;
      total += shown;
    }
    empty.classList.toggle('hidden', total > 0);
  };

  search.addEventListener('input', apply);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      zone = chip.dataset.zoneFilter!;
      for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
      apply();
    });
  }
</script>
