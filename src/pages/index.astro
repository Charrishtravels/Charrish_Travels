---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import CredentialsStrip from '../components/CredentialsStrip.astro';
import PackageCarousel from '../components/PackageCarousel.astro';
import { SITE } from '../consts';

const destinations = await getCollection('destinations');
const featured = destinations.filter((d) => d.data.featured);
const testimonials = (await getCollection('testimonials')).slice(0, 2);
const testimonialContent = await Promise.all(testimonials.map((t) => render(t)));
---

<Layout title="Home" description="Handpicked travel packages, planned around you.">
  <HeroCarousel>
    <p class="font-brand text-2xl sm:text-3xl">{SITE.name}</p>
    <div class="mt-3 h-px w-12 bg-white/50"></div>
    <p class="mt-3 text-xs font-medium uppercase tracking-[0.25em] text-white/80 sm:text-xs">
      {SITE.tagline}
    </p>
  </HeroCarousel>

  <section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
    <h2 class="font-brand text-2xl text-emerald-950">About {SITE.name}</h2>
    <p class="mt-4 text-xs text-emerald-900/70">
      {SITE.name} started with a simple idea: travel planning shouldn't feel like a second job. We
      put together itineraries the way we'd plan a trip for our own family — good stays, honest
      pricing, and no surprises once you've landed.
    </p>
    <a href="/about" class="mt-6 inline-block text-xs font-medium text-emerald-600 hover:underline">
      Learn more about us
    </a>
  </section>

  <CredentialsStrip />

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="font-brand text-2xl text-emerald-950">Featured packages</h2>
      <a href="/destinations" class="text-xs font-medium text-emerald-600 hover:underline">View all</a>
    </div>
    <PackageCarousel destinations={featured} />
  </section>

  <section class="bg-emerald-50/60 py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <h2 class="mb-8 text-center font-brand text-2xl text-emerald-950">What travellers say</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {testimonials.map((t, i) => {
          const { Content } = testimonialContent[i];
          return (
            <blockquote class="rounded-xl border border-emerald-100 bg-cream p-6">
              <div class="text-xs text-emerald-900/80 italic">
                <Content />
              </div>
              <footer class="mt-4 text-xs font-semibold text-emerald-950">
                {t.data.name}{t.data.location && <span class="font-normal text-emerald-900/60"> · {t.data.location}</span>}
              </footer>
            </blockquote>
          );
        })}
      </div>
      <div class="mt-8 text-center">
        <a href="/testimonials" class="text-xs font-medium text-emerald-600 hover:underline">Read all reviews</a>
      </div>
    </div>
  </section>
</Layout>
