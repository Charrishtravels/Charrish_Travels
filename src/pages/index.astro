---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import TempleTours from '../components/TempleTours.astro';
import Transportation from '../components/Transportation.astro';
import GuidedTours from '../components/GuidedTours.astro';
import VisaAssistance from '../components/VisaAssistance.astro';
import RouteWatermark from '../components/RouteWatermark.astro';
import PackageCarousel from '../components/PackageCarousel.astro';
import { SITE } from '../consts';
import southIndianTempleTank from '../assets/hero/south-indian-temple-tank.jpg';
import watArunBangkok from '../assets/hero/wat-arun-bangkok.jpg';
import hawaMahalJaipur from '../assets/hero/hawa-mahal-jaipur.jpg';
import swissAlpineVillage from '../assets/hero/swiss-alpine-village.jpg';
import dubai from '../assets/hero/dubai.jpg';
import maldives from '../assets/hero/maldives.jpg';
import himalayanSnowPass from '../assets/hero/himalayan-snow-pass.jpg';
import rockCutTempleHall from '../assets/hero/rock-cut-temple-hall.jpg';
import statsBackground from '../assets/stats-varanasi.jpg';

const statsBackgroundOptimized = await getImage({ src: statsBackground, width: 1600, format: 'webp' });

const destinations = await getCollection('destinations');
const featured = destinations.filter((d) => d.data.featured);

const testimonials = await getCollection('testimonials');
const shuffledTestimonials = [...testimonials].sort(() => Math.random() - 0.5).slice(0, 3);
const testimonialCards = await Promise.all(
  shuffledTestimonials.map(async (t) => ({ t, Content: (await render(t)).Content }))
);

const STATS = [
  {
    target: 200,
    suffix: '+',
    decimals: 0,
    label: 'Tours curated',
    icon: '<rect x="5" y="8.5" width="14" height="11.5" rx="1.5" /><path d="M9.5 8.5V6a1.5 1.5 0 0 1 1.5-1.5h2A1.5 1.5 0 0 1 14.5 6v2.5" /><line x1="5" y1="13" x2="19" y2="13" /><line x1="10" y1="8.5" x2="10" y2="20" /><line x1="14" y1="8.5" x2="14" y2="20" />',
  },
  {
    target: 20,
    suffix: '+',
    decimals: 0,
    label: 'Years of experience',
    icon: '<path d="M4 11.5 12 4l8 7.5" /><path d="M6 10.5V19a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-8.5" /><path d="M10 20v-4.5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1V20" />',
  },
  {
    target: 5000,
    suffix: '+',
    decimals: 0,
    label: 'Happy travellers',
    icon: '<circle cx="12" cy="5.2" r="2" /><rect x="9.7" y="8" width="4.6" height="6" rx="1.3" /><path d="M9.7 9.3H8a1 1 0 0 0-1 1v2.4a1 1 0 0 0 1 1h1.7" /><path d="M9.6 14l-2 6" /><path d="M14.4 14l2 6" /><path d="M14.3 8.6l3-1.6" />',
  },
  {
    target: 4.8,
    suffix: '',
    decimals: 1,
    label: 'Average rating',
    icon: '<path d="M12 3.8l1.9 4.5 4.9.5-3.7 3.3 1.1 4.8L12 14.4l-4.2 2.5 1.1-4.8-3.7-3.3 4.9-.5L12 3.8z" fill="currentColor" stroke="none" /><path d="M4.3 4.3l1 1M19.7 4.3l-1 1M3.3 12h1.4M20.7 12h-1.4M5.8 19l1-1M18.2 18l1 1" />',
  },
];
---

<Layout title="Home" description="Customized tours and temple tours, planned around you." transparentNav>
  <HeroCarousel
    slides={[
      { src: southIndianTempleTank, alt: 'South Indian temple tank and gopuram at dusk' },
      { src: watArunBangkok, alt: 'Wat Arun at sunset, Bangkok' },
      { src: hawaMahalJaipur, alt: 'Hawa Mahal, Jaipur' },
      { src: swissAlpineVillage, alt: 'Wooden chalets beneath a Swiss alpine peak' },
      { src: dubai, alt: 'Burj Al Arab at dusk, Dubai' },
      { src: maldives, alt: 'Overwater villas, Maldives' },
      { src: himalayanSnowPass, alt: 'Snow-covered Himalayan mountain pass' },
      { src: rockCutTempleHall, alt: 'Sunlit pillared hall of a rock-cut temple' },
    ]}
  >
    <div class="flex items-center justify-center gap-2 sm:gap-3">
      <span class="hidden h-px w-10 bg-temple-gold/60 sm:block"></span>
      <p class="font-brand text-[11px] tracking-[0.25em] text-earth uppercase sm:text-sm sm:tracking-[0.35em]">{SITE.name}</p>
      <span class="hidden h-px w-10 bg-temple-gold/60 sm:block"></span>
    </div>

    <h1 class="font-brand mt-3 text-[2rem] leading-[1.15] text-earth sm:mt-5 sm:text-6xl lg:text-7xl">
      Travel, Planned Around You.
    </h1>

    <p class="mt-3 flex flex-wrap items-center justify-center gap-x-2 gap-y-1.5 text-[11px] font-semibold tracking-[0.1em] text-earth uppercase sm:mt-5 sm:gap-x-3 sm:text-sm sm:tracking-[0.15em]">
      <span class="whitespace-nowrap">Customized Tours <span class="text-ink-muted/70" aria-hidden="true">|</span></span>
      <span class="whitespace-nowrap">Temple Tours <span class="text-ink-muted/70" aria-hidden="true">|</span></span>
      <span class="whitespace-nowrap">Guided Tours <span class="text-ink-muted/70" aria-hidden="true">|</span></span>
      <span class="whitespace-nowrap">Visa Assistance</span>
    </p>

    <a
      href="/about"
      class="mt-6 inline-block rounded-full bg-saffron px-7 py-3 text-xs font-semibold tracking-wide text-on-saffron shadow-lg transition-all duration-200 hover:scale-105 hover:bg-saffron-deep active:scale-95 sm:mt-8"
    >
      Begin your journey
    </a>
  </HeroCarousel>

  <section class="relative overflow-hidden bg-sand px-4 py-16 sm:px-6 sm:py-20">
    <RouteWatermark />
    <div class="relative mx-auto max-w-2xl text-center" data-reveal="up">
      <h2 class="font-brand text-4xl leading-tight text-earth">
        We believe every traveller is different — and your journey should be too.
      </h2>
      <p class="mt-5 text-xs text-ink-muted sm:text-sm">
        <span class="text-earth underline decoration-temple-gold decoration-1 underline-offset-4">
          Customization isn't a feature — it's our main service.
        </span>{' '}
        Rather than fitting you into a fixed package, we build your itinerary around how you want
        to travel.
      </p>
      <p class="mt-3 text-xs text-ink-muted sm:text-sm">
        That means a family holiday paced for every generation, a honeymoon built around quiet,
        shared moments, a group trip that stays coordinated without losing anyone's individual
        experience, and senior-friendly journeys that favour comfort at every step.
      </p>
      <p class="mt-3 text-xs text-ink-muted sm:text-sm">
        Behind it all: strong destination-wise transportation arrangements, trusted local
        partners, and years of experience — so the logistics stay invisible, and the journey
        feels effortless.
      </p>
      <p class="mt-3 text-xs text-ink-muted sm:text-sm">
        Family holiday, pilgrimage, group trip, or international getaway — we work closely with
        you to shape something entirely your own.
      </p>

      <p class="font-brand mt-5 text-lg text-earth">Your journey begins with a conversation.</p>

      <a
        href={`https://wa.me/${SITE.whatsapp}`}
        target="_blank"
        rel="noopener"
        class="mt-4 inline-block rounded-full bg-saffron px-6 py-3 text-xs font-semibold text-on-saffron transition-all duration-200 hover:scale-105 hover:bg-saffron-deep active:scale-95"
      >
        Start a Conversation
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="grid gap-6">
      <Transportation />
      <VisaAssistance />
      <TempleTours />
      <GuidedTours />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-4" data-reveal="up">
      <h2 class="font-brand flex items-center gap-3 text-4xl text-earth">
        <svg viewBox="0 0 20 20" class="h-6 w-6 shrink-0 text-saffron" aria-hidden="true">
          <path d="M10 0 L10.77 8.15 L14.24 5.76 L11.85 9.23 L20 10 L11.85 10.77 L14.24 14.24 L10.77 11.85 L10 20 L9.23 11.85 L5.76 14.24 L8.15 10.77 L0 10 L8.15 9.23 L5.76 5.76 L9.23 8.15 Z" fill="currentColor" />
        </svg>
        Featured tours
      </h2>
      <a
        href="/tours"
        class="hidden w-fit shrink-0 items-center gap-2 rounded-full bg-saffron px-6 py-3 text-xs font-semibold text-on-saffron transition-all duration-200 hover:scale-105 hover:bg-saffron-deep active:scale-95 sm:inline-flex"
      >
        View more
        <span class="text-on-saffron/70" aria-hidden="true">→</span>
      </a>
    </div>
    <div data-reveal="up" style="--reveal-delay: 120ms">
      <PackageCarousel destinations={featured} />
    </div>
    <div class="mt-6 flex justify-center sm:hidden">
      <a
        href="/tours"
        class="inline-flex w-fit items-center gap-2 rounded-full bg-saffron px-6 py-3 text-xs font-semibold text-on-saffron transition-all duration-200 hover:scale-105 hover:bg-saffron-deep active:scale-95"
      >
        View more
        <span class="text-on-saffron/70" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section id="stats-section" class="relative overflow-hidden py-16">
    <div
      class="absolute inset-0 -z-10 bg-cover bg-fixed"
      style={`background-image: url(${statsBackgroundOptimized.src}); background-position: 50% 55%;`}
    >
    </div>
    <div class="absolute inset-0 bg-page/55"></div>
    <div class="relative mx-auto grid max-w-5xl grid-cols-2 gap-x-6 gap-y-8 px-4 sm:flex sm:flex-wrap sm:justify-between sm:gap-x-8 sm:px-10">
      {STATS.map((stat, i) => (
        <div class="group text-center" data-reveal="zoom" style={`--reveal-delay: ${i * 110}ms`}>
          <div class="relative mx-auto mb-3 h-12 w-12 rounded-full border-[3px] border-temple-gold/60 sm:h-14 sm:w-14 sm:border-4">
            <div class="absolute inset-0.5 overflow-hidden rounded-full sm:inset-1">
              <span class="absolute inset-0 flex items-center justify-center bg-card/70 text-temple-gold backdrop-blur-sm transition-transform duration-300 ease-out group-hover:-translate-x-full">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5 sm:h-6 sm:w-6"
                  set:html={stat.icon}
                />
              </span>
              <span class="absolute inset-0 flex translate-x-full items-center justify-center bg-card/70 text-temple-gold backdrop-blur-sm transition-transform duration-300 ease-out group-hover:translate-x-0">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5 sm:h-6 sm:w-6"
                  set:html={stat.icon}
                />
              </span>
            </div>
          </div>
          <p
            class="stat-value font-brand text-3xl text-earth sm:text-5xl"
            data-target={stat.target}
            data-decimals={stat.decimals}
            data-suffix={stat.suffix}
          >
            {stat.decimals ? (0).toFixed(stat.decimals) : '0'}{stat.suffix}
          </p>
          <p class="mt-0.5 text-[11px] font-semibold text-earth sm:text-xs">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-sand">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="mb-8 font-brand text-4xl text-earth" data-reveal="up">What Travellers Say</h2>

    <div class="grid gap-5 sm:grid-cols-3">
      {testimonialCards.map(({ t, Content }, i) => (
        <blockquote
          class="rounded-xl border border-line bg-card p-5 shadow-review"
          data-reveal="up"
          style={`--reveal-delay: ${120 + i * 130}ms`}
        >
          <div class="text-temple-gold" aria-hidden="true">{'★'.repeat(t.data.rating)}{'☆'.repeat(5 - t.data.rating)}</div>
          <div class="mt-2 text-xs leading-relaxed text-ink-muted italic">
            <Content />
          </div>
          <footer class="mt-4 text-xs font-semibold text-earth">
            {t.data.name}
            {t.data.occupation && <span class="font-normal text-ink-muted"> · {t.data.occupation}</span>}
          </footer>
        </blockquote>
      ))}
    </div>

    <div class="mt-8 flex justify-center">
      <a
        href="/testimonials#review-form"
        class="inline-flex w-fit shrink-0 items-center gap-2 rounded-full bg-saffron px-6 py-3 text-xs font-semibold text-on-saffron transition-all duration-200 hover:scale-105 hover:bg-saffron-deep active:scale-95"
      >
        Leave a Review
      </a>
    </div>
  </div>
  </section>
</Layout>

<script>
  const statsSection = document.getElementById('stats-section');
  const statEls = Array.from(document.querySelectorAll<HTMLElement>('.stat-value'));

  function animateCount(el: HTMLElement) {
    const target = parseFloat(el.dataset.target ?? '0');
    const decimals = parseInt(el.dataset.decimals ?? '0', 10);
    const suffix = el.dataset.suffix ?? '';
    const duration = 2000;
    const start = performance.now();

    function easeInOutQuad(t: number) {
      return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
    }

    function frame(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const current = target * easeInOutQuad(progress);
      el.textContent =
        current.toLocaleString('en-US', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        }) + suffix;
      if (progress < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  if (statsSection && statEls.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            statEls.forEach(animateCount);
            observer.unobserve(statsSection);
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(statsSection);
  }
</script>
