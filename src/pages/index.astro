---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import PackageCarousel from '../components/PackageCarousel.astro';
import { SITE } from '../consts';
import indiaTemple from '../assets/hero/india-temple.webp';
import heritageTourOfIndia from '../assets/heritage-tour-of-india.jpg';
import statsBackground from '../assets/stats-background.jpg';

const statsBackgroundOptimized = await getImage({ src: statsBackground, width: 1600, format: 'webp' });

const destinations = await getCollection('destinations');
const featured = destinations.filter((d) => d.data.featured);
const testimonials = await getCollection('testimonials');
const testimonialContent = await Promise.all(testimonials.map((t) => render(t)));
const testimonialPages = Array.from({ length: Math.ceil(testimonials.length / 2) }, (_, i) =>
  testimonials.slice(i * 2, i * 2 + 2).map((t, j) => ({ t, Content: testimonialContent[i * 2 + j].Content }))
);

const STATS = [
  { value: '200+', label: 'Packages curated' },
  { value: '20+', label: 'Years of experience' },
  { value: '5,000+', label: 'Happy travellers' },
  { value: '4.8★', label: 'Average rating' },
];

const TICKER_ITEMS = [
  'Handpicked stays',
  'Transparent pricing',
  '200+ packages curated',
  'Real support, always',
  '4.8★ average rating',
];
---

<Layout title="Home" description="Handpicked travel packages, planned around you." transparentNav>
  <HeroCarousel>
    <p class="font-brand text-4xl uppercase tracking-wide sm:text-5xl">{SITE.name}</p>
    <div class="mt-3 h-px w-12 bg-white/50"></div>
    <p class="mt-3 text-xs font-medium uppercase tracking-[0.25em] text-white/80 sm:text-xs">
      {SITE.tagline}
    </p>
  </HeroCarousel>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="font-brand text-4xl text-emerald-950">About us</h2>
        <p class="mt-4 text-xs text-black">
          {SITE.name} started with a simple idea: travel planning shouldn't feel like a second job. We
          put together itineraries the way we'd plan a trip for our own family — good stays, honest
          pricing, and no surprises once you've landed. Every package on this site has been travelled
          and vetted by our own team before it ever gets listed.
        </p>

        <ul class="mt-6 space-y-2.5 text-xs text-black">
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-700"></span>
            Handpicked stays and vetted local partners
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-700"></span>
            Transparent, all-inclusive pricing — no hidden add-ons
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-700"></span>
            Real support before, during, and after your trip
          </li>
        </ul>

        <a
          href="/about"
          class="mt-6 inline-block rounded-full bg-emerald-800 px-6 py-3 text-xs font-semibold text-white transition-all duration-200 hover:scale-105 hover:bg-emerald-900 active:scale-95"
        >
          More about us
        </a>
      </div>

      <div class="relative mx-auto h-72 w-full max-w-sm sm:h-80">
        <Image
          src={indiaTemple}
          alt="Ornate temple, India"
          widths={[400, 640]}
          sizes="(min-width: 640px) 384px, 90vw"
          class="absolute inset-0 h-full w-full rounded-2xl object-cover shadow-lg"
        />
        <Image
          src={heritageTourOfIndia}
          alt="Heritage tour of India"
          widths={[200, 300]}
          sizes="192px"
          class="absolute -right-1 -bottom-4 h-40 w-40 rotate-6 rounded-2xl border-4 border-cream object-cover shadow-xl sm:-right-4 sm:-bottom-6 sm:h-48 sm:w-48"
        />
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-16">
    <div
      class="absolute inset-0 -z-10 bg-cover bg-fixed"
      style={`background-image: url(${statsBackgroundOptimized.src}); background-position: 30% 60%;`}
    >
    </div>
    <div class="absolute inset-0 bg-emerald-950/30"></div>
    <div class="relative mx-auto grid max-w-5xl grid-cols-2 gap-x-6 gap-y-8 px-4 sm:flex sm:flex-wrap sm:justify-between sm:gap-x-8 sm:px-10">
      {STATS.map((stat) => (
        <div class="text-center">
          <p class="font-brand text-3xl text-white sm:text-5xl">{stat.value}</p>
          <p class="mt-0.5 text-[11px] font-semibold text-white sm:text-xs">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-4">
      <h2 class="font-brand text-4xl text-emerald-950">Featured packages</h2>
      <a
        href="/destinations"
        class="hidden w-fit shrink-0 items-center gap-2 rounded-full bg-emerald-800 px-6 py-3 text-xs font-semibold text-white transition-all duration-200 hover:scale-105 hover:bg-emerald-900 active:scale-95 sm:inline-flex"
      >
        View more
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <PackageCarousel destinations={featured} />
    <div class="mt-6 flex justify-center sm:hidden">
      <a
        href="/destinations"
        class="inline-flex w-fit items-center gap-2 rounded-full bg-emerald-800 px-6 py-3 text-xs font-semibold text-white transition-all duration-200 hover:scale-105 hover:bg-emerald-900 active:scale-95"
      >
        View more
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <div class="overflow-hidden bg-emerald-800 py-3">
    <div class="ticker-track flex w-max items-center gap-10 whitespace-nowrap">
      {Array(2).fill(TICKER_ITEMS).flat().map((item) => (
        <span class="flex items-center gap-10">
          <span class="text-xs font-semibold uppercase tracking-wider text-white">{item}</span>
          <span aria-hidden="true" class="text-white/40">✦</span>
        </span>
      ))}
    </div>
  </div>

  <section class="pt-8 pb-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <h2 class="mb-8 text-center font-brand text-4xl text-emerald-950">What travellers say</h2>
      <div id="testimonial-pages" class="relative">
        {testimonialPages.map((page, pageIndex) => (
          <div
            class="testimonial-page grid gap-6 transition-opacity duration-700 sm:grid-cols-2"
            data-page={pageIndex}
            style={pageIndex === 0 ? undefined : { display: 'none' }}
          >
            {page.map(({ t, Content }) => (
              <blockquote class="rounded-xl border border-emerald-600 bg-cream p-6 shadow-sm">
                <div class="text-amber-500" aria-hidden="true">{'★'.repeat(t.data.rating)}{'☆'.repeat(5 - t.data.rating)}</div>
                <div class="mt-2 text-xs text-emerald-900/80 italic">
                  <Content />
                </div>
                <footer class="mt-4 text-xs font-semibold text-emerald-950">
                  {t.data.name}{t.data.location && <span class="font-normal text-emerald-900/60"> · {t.data.location}</span>}
                </footer>
              </blockquote>
            ))}
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-col items-center gap-2 text-center">
        <p class="text-xs text-emerald-900/60">Travelled with us before?</p>
        <a
          href="/testimonials#review-form"
          class="inline-flex w-fit items-center rounded-full bg-emerald-800 px-6 py-3 text-xs font-semibold text-white transition-all duration-200 hover:scale-105 hover:bg-emerald-900 active:scale-95"
        >
          Leave a review
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const pages = Array.from(document.querySelectorAll<HTMLElement>('.testimonial-page'));
  if (pages.length > 1) {
    let active = 0;
    setInterval(() => {
      pages[active].style.display = 'none';
      active = (active + 1) % pages.length;
      pages[active].style.display = '';
    }, 7000);
  }
</script>

<style>
  .ticker-track {
    animation: ticker-scroll 28s linear infinite;
  }

  @keyframes ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
