---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DestinationCard from '../components/DestinationCard.astro';
import { SITE } from '../consts';

const destinations = await getCollection('destinations');
const featured = destinations.filter((d) => d.data.featured);
const testimonials = (await getCollection('testimonials')).slice(0, 2);
const testimonialContent = await Promise.all(testimonials.map((t) => render(t)));
---

<Layout title="Home" description="Handpicked travel packages, planned around you.">
  <section class="mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 sm:py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-emerald-600">{SITE.name}</p>
    <h1 class="mt-3 font-serif text-3xl leading-tight text-emerald-950 sm:text-5xl">
      Journeys planned around you
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-base text-emerald-900/70 sm:text-lg">
      From weekend beach escapes to guided treks, we handle the logistics so you can just show up and enjoy it.
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/destinations"
        class="w-full rounded-full bg-emerald-700 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-emerald-800 sm:w-auto"
      >
        Explore destinations
      </a>
      <a
        href="/contact"
        class="w-full rounded-full border border-emerald-200 px-6 py-3 text-sm font-semibold text-emerald-900 transition-colors hover:bg-emerald-50 sm:w-auto"
      >
        Plan a custom trip
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="font-serif text-2xl text-emerald-950">Featured packages</h2>
      <a href="/destinations" class="text-sm font-medium text-emerald-600 hover:underline">View all</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((destination) => <DestinationCard destination={destination} />)}
    </div>
  </section>

  <section class="bg-emerald-50/60 py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <h2 class="mb-8 text-center font-serif text-2xl text-emerald-950">What travellers say</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {testimonials.map((t, i) => {
          const { Content } = testimonialContent[i];
          return (
            <blockquote class="rounded-xl border border-emerald-100 bg-white p-6">
              <div class="text-sm text-emerald-900/80 italic">
                <Content />
              </div>
              <footer class="mt-4 text-sm font-semibold text-emerald-950">
                {t.data.name}{t.data.location && <span class="font-normal text-emerald-900/60"> · {t.data.location}</span>}
              </footer>
            </blockquote>
          );
        })}
      </div>
      <div class="mt-8 text-center">
        <a href="/testimonials" class="text-sm font-medium text-emerald-600 hover:underline">Read all reviews</a>
      </div>
    </div>
  </section>
</Layout>
