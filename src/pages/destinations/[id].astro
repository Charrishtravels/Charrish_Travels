---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const destinations = await getCollection('destinations');
  return destinations.map((destination) => ({
    params: { id: destination.id },
    props: { destination },
  }));
}

const { destination } = Astro.props;
const {
  title,
  location,
  summary,
  heroImage,
  priceFrom,
  duration,
  route,
  departureDates,
  groupSize,
  vehicle,
  highlights,
  travelArrangements,
  assistance,
  specialExperience,
  itinerary,
  importantNotes,
} = destination.data;
const { Content } = await render(destination);

type Block = { type: 'list'; items: string[] } | { type: 'p'; text: string };

function parseDetails(text: string): Block[] {
  const lines = text
    .split('\n')
    .map((l) => l.trim())
    .filter((l) => l.length > 0);

  const blocks: Block[] = [];
  let currentList: string[] = [];

  const flushList = () => {
    if (currentList.length > 0) {
      blocks.push({ type: 'list', items: currentList });
      currentList = [];
    }
  };

  for (const line of lines) {
    if (line.startsWith('•')) {
      currentList.push(line.replace(/^•\s*/, ''));
    } else {
      flushList();
      blocks.push({ type: 'p', text: line });
    }
  }
  flushList();
  return blocks;
}

const quickFacts = [
  { label: 'Duration', value: duration },
  { label: 'Route', value: route },
  { label: 'Departure', value: departureDates },
  { label: 'Group Size', value: groupSize },
  { label: 'Vehicle', value: vehicle },
].filter((fact) => fact.value);
---

<Layout title={title} description={summary}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">{location}</p>
    <h1 class="mt-2 font-brand text-5xl text-emerald-950 sm:text-6xl">{title}</h1>

    <img
      src={heroImage}
      alt={title}
      class="mt-6 aspect-[16/9] w-full rounded-xl object-cover"
    />

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 border-y border-emerald-100 py-4 text-xs">
      {quickFacts.map((fact) => (
        <span class="text-emerald-900/70">
          <span class="font-semibold text-emerald-900">{fact.label}:</span> {fact.value}
        </span>
      ))}
      <span class="font-semibold text-emerald-900">
        {priceFrom ? `from ₹${priceFrom.toLocaleString('en-IN')} / person` : 'Enquire for pricing'}
      </span>
    </div>

    <div class="prose prose-emerald mt-6 max-w-none text-xs text-emerald-900/80">
      <Content />
    </div>

    {highlights.length > 0 && (
      <div class="mt-8">
        <h2 class="font-brand text-3xl text-emerald-950">Tour Highlights</h2>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {highlights.map((h: string) => (
            <li class="flex items-start gap-2 text-xs text-emerald-900/80">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span>
              {h}
            </li>
          ))}
        </ul>
      </div>
    )}

    {travelArrangements && (
      <div class="mt-8">
        <h2 class="font-brand text-3xl text-emerald-950">Travel Arrangements</h2>
        <dl class="mt-3 grid gap-x-8 gap-y-2 text-xs text-emerald-900/80 sm:grid-cols-2">
          {travelArrangements.vehicle && (
            <div><dt class="font-semibold text-emerald-900">Vehicle</dt><dd>{travelArrangements.vehicle}</dd></div>
          )}
          {travelArrangements.group && (
            <div><dt class="font-semibold text-emerald-900">Group</dt><dd>{travelArrangements.group}</dd></div>
          )}
          {travelArrangements.water && (
            <div><dt class="font-semibold text-emerald-900">Water</dt><dd>{travelArrangements.water}</dd></div>
          )}
          {travelArrangements.breakfast && (
            <div><dt class="font-semibold text-emerald-900">Breakfast</dt><dd>{travelArrangements.breakfast}</dd></div>
          )}
          {travelArrangements.lunch && (
            <div><dt class="font-semibold text-emerald-900">Lunch</dt><dd>{travelArrangements.lunch}</dd></div>
          )}
          {travelArrangements.dinner && (
            <div><dt class="font-semibold text-emerald-900">Dinner</dt><dd>{travelArrangements.dinner}</dd></div>
          )}
        </dl>
      </div>
    )}

    {specialExperience && (
      <div class="mt-8 rounded-xl border border-emerald-100 bg-cream p-5">
        <h2 class="font-brand text-2xl text-emerald-950">{specialExperience.title}</h2>
        <p class="mt-2 text-xs text-emerald-900/80">{specialExperience.body}</p>
      </div>
    )}

    {assistance && (assistance.places.length > 0 || assistance.note) && (
      <div class="mt-8">
        <h2 class="font-brand text-3xl text-emerald-950">Darshan / Local Assistance</h2>
        {assistance.places.length > 0 && (
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            {assistance.places.map((place: string) => (
              <li class="flex items-start gap-2 text-xs text-emerald-900/80">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                {place}
              </li>
            ))}
          </ul>
        )}
        {assistance.note && <p class="mt-3 text-xs text-emerald-900/60">{assistance.note}</p>}
      </div>
    )}

    {itinerary.length > 0 && (
      <div class="mt-8">
        <h2 class="font-brand text-3xl text-emerald-950">Day-by-Day Itinerary</h2>
        <div class="mt-3 divide-y divide-emerald-100 border-y border-emerald-100">
          {itinerary.map((day) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-baseline justify-between gap-4 text-xs font-medium text-emerald-950">
                <span>
                  <span class="font-brand text-emerald-600">Day {day.day}</span>
                  {day.date && <span class="text-emerald-900/60"> · {day.date}</span>}
                  <span class="ml-2">{day.title}</span>
                </span>
                <span class="shrink-0 text-emerald-600 transition-transform group-open:rotate-45">+</span>
              </summary>
              <div class="mt-3 space-y-3 text-xs text-emerald-900/80">
                {parseDetails(day.details).map((block) =>
                  block.type === 'list' ? (
                    <ul class="grid gap-1.5">
                      {block.items.map((item) => (
                        <li class="flex items-start gap-2">
                          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p>{block.text}</p>
                  )
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    )}

    {importantNotes.length > 0 && (
      <div class="mt-8">
        <h2 class="font-brand text-3xl text-emerald-950">Important Notes</h2>
        <ul class="mt-3 grid gap-2">
          {importantNotes.map((note: string) => (
            <li class="flex items-start gap-2 text-xs text-emerald-900/70">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-300"></span>
              {note}
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a
        href="/contact"
        class="w-full rounded-full bg-emerald-700 px-6 py-3 text-center text-xs font-semibold text-white transition-colors hover:bg-emerald-800 sm:w-auto"
      >
        Enquire about this package
      </a>
      <a
        href="/destinations"
        class="w-full rounded-full border border-emerald-200 px-6 py-3 text-center text-xs font-semibold text-emerald-900 transition-colors hover:bg-emerald-50 sm:w-auto"
      >
        Back to all packages
      </a>
    </div>
  </article>
</Layout>
