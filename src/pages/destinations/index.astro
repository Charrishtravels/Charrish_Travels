---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DestinationCard from '../../components/DestinationCard.astro';

const destinations = await getCollection('destinations');
---

<Layout title="Destinations & Packages" description="Browse all Charrish Travels destinations and packages.">
  <section class="bg-emerald-950 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h1 class="font-brand text-5xl text-white">Destinations & Packages</h1>
      <p class="mt-3 max-w-2xl text-xs text-gold-300 sm:text-sm lg:max-w-none">
        Every package below can be customized — get in touch if you'd like a different duration, group size, or add-on.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {destinations.map((destination, i) => (
        <div data-reveal="up" style={`--reveal-delay: ${(i % 3) * 110}ms`}>
          <DestinationCard destination={destination} orientation="landscape" />
        </div>
      ))}
    </div>
  </section>
</Layout>
