---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DestinationCard from '../../components/DestinationCard.astro';

const destinations = await getCollection('destinations');
---

<Layout title="Destinations & Packages" description="Browse all Charrish Travels destinations and packages.">
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <h1 class="font-brand text-3xl text-emerald-950">Destinations & Packages</h1>
    <p class="mt-2 max-w-2xl text-xs text-emerald-900/70">
      Every package below can be customized — get in touch if you'd like a different duration, group size, or add-on.
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {destinations.map((destination) => <DestinationCard destination={destination} />)}
    </div>
  </section>
</Layout>
