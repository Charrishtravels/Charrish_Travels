---
import { getCollection, render } from 'astro:content';
import AdminLayout from '../../layouts/AdminLayout.astro';

const testimonials = await getCollection('testimonials');
const rendered = await Promise.all(testimonials.map((t) => render(t)));
---

<AdminLayout title="Testimonials" description="Manage traveller testimonials and moderate submitted reviews.">
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <h1 class="font-brand text-5xl text-emerald-950">Testimonials</h1>

    <div id="login-gate" class="mt-8">
      <p class="text-xs text-emerald-900/70">Log in to manage testimonials and moderate pending reviews.</p>
      <button
        id="login-button"
        class="mt-4 rounded-full bg-emerald-700 px-6 py-3 text-xs font-semibold text-white hover:bg-emerald-800"
      >
        Log in
      </button>
    </div>

    <div id="dashboard" class="mt-8 hidden">
      <div class="flex items-center justify-between">
        <p class="text-xs text-emerald-900/70">Logged in as <span id="user-email" class="font-medium"></span></p>
        <button id="logout-button" class="text-xs font-medium text-emerald-600 hover:underline">Log out</button>
      </div>

      <a
        href="/admin/index.html#/collections/testimonials/new"
        class="mt-6 inline-block rounded-full bg-emerald-700 px-6 py-3 text-xs font-semibold text-white hover:bg-emerald-800"
      >
        Add a testimonial
      </a>

      <div id="review-section" class="mt-10 hidden">
        <h2 class="font-brand text-3xl text-emerald-950">Review testimonials</h2>
        <div id="pending-list" class="mt-4 space-y-4"></div>
      </div>

      <div class="mt-10">
        <h2 class="font-brand text-3xl text-emerald-950">Current testimonials</h2>
        {testimonials.length === 0 && (
          <p class="mt-4 text-xs text-emerald-900/60">No testimonials yet.</p>
        )}
        <div class="mt-4 grid gap-6 sm:grid-cols-2">
          {testimonials.map((t, i) => {
            const { Content } = rendered[i];
            return (
              <blockquote class="relative rounded-xl border border-emerald-100 bg-cream p-6 shadow-sm">
                <a
                  href={`/admin/index.html#/collections/testimonials/entries/${t.id}`}
                  class="absolute right-4 top-4 rounded-full border border-emerald-200 px-3 py-1 text-[0.65rem] font-semibold text-emerald-900 hover:bg-emerald-50"
                >
                  Edit
                </a>
                <div class="text-amber-500" aria-hidden="true">{'★'.repeat(t.data.rating)}{'☆'.repeat(5 - t.data.rating)}</div>
                <div class="mt-2 pr-14 text-xs text-emerald-900/80 italic">
                  <Content />
                </div>
                <footer class="mt-4 text-xs font-semibold text-emerald-950">
                  {t.data.name}{t.data.location && <span class="font-normal text-emerald-900/60"> · {t.data.location}</span>}
                </footer>
              </blockquote>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</AdminLayout>

<script>
  declare global {
    interface Window {
      netlifyIdentity: any;
    }
  }

  const loginGate = document.getElementById('login-gate');
  const dashboard = document.getElementById('dashboard');
  const userEmailEl = document.getElementById('user-email');
  const reviewSection = document.getElementById('review-section');
  const pendingList = document.getElementById('pending-list');
  const loginButton = document.getElementById('login-button');
  const logoutButton = document.getElementById('logout-button');

  function escapeHtml(value: string) {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  async function loadPendingReviews(token: string) {
    const res = await fetch('/.netlify/functions/list-pending-reviews', {
      headers: { Authorization: `Bearer ${token}` },
    });

    if (!res.ok) {
      if (pendingList && reviewSection) {
        reviewSection.classList.remove('hidden');
        pendingList.innerHTML = '<p class="text-xs text-red-600">Could not load pending reviews.</p>';
      }
      return;
    }

    const { reviews } = await res.json();
    if (!pendingList || !reviewSection) return;

    if (!reviews || reviews.length === 0) {
      reviewSection.classList.add('hidden');
      pendingList.innerHTML = '';
      return;
    }

    reviewSection.classList.remove('hidden');
    pendingList.innerHTML = reviews
      .map(
        (r: { id: string; name: string; rating: number; message: string }) => `
      <div class="rounded-xl border border-emerald-100 bg-cream p-4" data-review-id="${r.id}">
        <div class="text-amber-500">${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)}</div>
        <p class="mt-1 text-xs text-emerald-900/80">"${escapeHtml(r.message)}"</p>
        <p class="mt-2 text-xs font-semibold text-emerald-950">${escapeHtml(r.name)}</p>
        <div class="mt-3 flex gap-2">
          <button data-action="approve" class="rounded-full bg-emerald-700 px-4 py-1.5 text-xs font-semibold text-white hover:bg-emerald-800">Approve</button>
          <button data-action="reject" class="rounded-full border border-red-200 px-4 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-50">Reject</button>
        </div>
      </div>`
      )
      .join('');
  }

  async function moderate(id: string, action: 'approve' | 'reject', token: string) {
    await fetch('/.netlify/functions/moderate-review', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ id, action }),
    });
    await loadPendingReviews(token);
  }

  pendingList?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const action = target.dataset.action as 'approve' | 'reject' | undefined;
    if (!action) return;

    const card = target.closest('[data-review-id]') as HTMLElement | null;
    const id = card?.dataset.reviewId;
    const user = window.netlifyIdentity?.currentUser();
    const token = user?.token?.access_token;
    if (!id || !token) return;

    await moderate(id, action, token);
  });

  function showDashboard(user: any) {
    loginGate?.classList.add('hidden');
    dashboard?.classList.remove('hidden');
    if (userEmailEl) userEmailEl.textContent = user.email;
    loadPendingReviews(user.token.access_token);
  }

  function showLoginGate() {
    dashboard?.classList.add('hidden');
    loginGate?.classList.remove('hidden');
  }

  window.addEventListener('DOMContentLoaded', () => {
    const identity = window.netlifyIdentity;
    if (!identity) return;

    // The widget auto-calls init() on its own DOMContentLoaded listener, which
    // can fire before this one registers — so check the already-loaded session
    // synchronously instead of relying solely on the async 'init' event.
    const existingUser = identity.currentUser();
    if (existingUser) showDashboard(existingUser);

    identity.on('init', (user: any) => (user ? showDashboard(user) : showLoginGate()));
    identity.on('login', (user: any) => {
      showDashboard(user);
      identity.close();
    });
    identity.on('logout', () => showLoginGate());

    loginButton?.addEventListener('click', () => identity.open('login'));
    logoutButton?.addEventListener('click', () => identity.logout());

    identity.init();
  });
</script>
