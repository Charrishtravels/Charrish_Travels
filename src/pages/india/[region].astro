---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import RegionCard from '../../components/RegionCard.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import CustomiseNote from '../../components/CustomiseNote.astro';
import { SITE } from '../../consts';
import { allRegions, regionHref, type RegionWithPhoto } from '../../data/india';

export function getStaticPaths() {
  return allRegions.map((region) => ({ params: { region: region.slug }, props: { region } }));
}

interface Props {
  region: RegionWithPhoto;
}

const { region } = Astro.props;
const kindLabel = region.kind === 'state' ? 'State' : 'Union Territory';

// Prev/next in the same alphabetical list (states with states, UTs with UTs).
const siblings = allRegions.filter((r) => r.kind === region.kind);
const idx = siblings.findIndex((r) => r.slug === region.slug);
const prev = siblings[(idx - 1 + siblings.length) % siblings.length];
const next = siblings[(idx + 1) % siblings.length];
const nearby = allRegions.filter((r) => r.zone === region.zone && r.slug !== region.slug).slice(0, 4);

const title = `${region.name} Tour Packages – Popular Places to Visit & Temples`;
const topPlaces = region.destinations.slice(0, 4).map((d) => d.name).join(', ');
const description = `Plan a custom ${region.name} holiday: ${topPlaces} and more. Temples and pilgrimage sites, sightseeing highlights, best time to visit and a free quote from ${SITE.name}.`;
const ogImage = (await getImage({ src: region.photo, width: 1200, format: 'jpg' })).src;


// Two columns on the page: places of worship, and everything else.
const placeGroups = [
  {
    title: 'Devotional',
    tab: 'Devotional',
    subtitle: 'Temples, shrines & pilgrimage',
    places: region.devotional,
    tone: 'border-saffron/30 bg-sand',
    // Temple outline
    icon: '<path d="M12 2l1.5 3h-3L12 2z"/><path d="M8 9h8l-1-4H9L8 9z"/><path d="M5 13h14l-2-4H7l-2 4z"/><path d="M4 22V13h16v9"/><path d="M10 22v-5h4v5"/>',
  },
  {
    title: 'Sightseeing & leisure',
    tab: 'Sightseeing',
    subtitle: 'Nature, heritage & cities',
    places: region.destinations,
    tone: 'border-line bg-card',
    // Mountain outline
    icon: '<path d="M3 20l6-10 4 6 3-4 5 8H3z"/><circle cx="17" cy="6" r="2"/>',
  },
];

const STAR_PATH =
  'M10 0 L10.77 8.15 L14.24 5.76 L11.85 9.23 L20 10 L11.85 10.77 L14.24 14.24 L10.77 11.85 L10 20 L9.23 11.85 L5.76 14.24 L8.15 10.77 L0 10 L8.15 9.23 L5.76 5.76 L9.23 8.15 Z';

const pageUrl = new URL(regionHref(region.slug), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TouristDestination',
      name: region.name,
      description: region.intro,
      url: pageUrl,
      image: new URL(ogImage, Astro.site).href,
      containedInPlace: { '@type': 'Country', name: 'India' },
      includesAttraction: [...region.devotional, ...region.destinations].map((d) => ({ '@type': 'TouristAttraction', name: d.name, description: d.blurb })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
        { '@type': 'ListItem', position: 2, name: 'Domestic Tours', item: new URL('/tours/domestic', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: region.name, item: pageUrl },
      ],
    },
  ],
};

const facts = [
  { label: kindLabel === 'State' ? 'Capital' : 'Capital / seat', value: region.capital },
  { label: 'Best time', value: region.bestTime },
  { label: 'Ideal trip', value: region.idealDuration },
  { label: 'Region', value: `${region.zone} India` },
];
---

<Layout title={title} description={description} image={ogImage} whatsappMessage={`Hi Charrish Travels, I'd like to plan a trip to ${region.name}.`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="relative isolate flex min-h-[24rem] items-end overflow-hidden sm:min-h-[30rem]">
    <Image src={region.photo} alt={region.photoAlt} widths={[800, 1280]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-page via-page/80 via-45% to-page/10"></div>
    {/* Phones: the text covers most of the photo, so wash it lighter for legibility. */}
    <div class="absolute inset-0 -z-10 bg-page/55 sm:hidden"></div>
    <div class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20" data-reveal="up">
      <p class="flex items-center gap-2 text-[11px] font-semibold tracking-[0.2em] text-saffron-deep uppercase">
        <svg viewBox="0 0 20 20" class="h-3.5 w-3.5 text-temple-gold" aria-hidden="true"><path d={STAR_PATH} fill="currentColor" /></svg>
        {kindLabel} · {region.zone} India
      </p>
      <h1 class="font-brand mt-2 text-4xl leading-tight text-earth sm:text-6xl">{region.name}</h1>
      <p class="mt-3 max-w-2xl text-sm text-ink-muted sm:text-base">{region.tagline}</p>
    </div>
  </section>

  <div class="relative mx-auto -mt-8 max-w-6xl px-4 sm:px-6">
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line shadow-lg lg:grid-cols-4">
      {facts.map((f) => (
        <div class="bg-card px-4 py-3.5 sm:px-5 sm:py-4">
          <dt class="text-[10px] font-semibold tracking-[0.18em] text-maroon uppercase">{f.label}</dt>
          <dd class="mt-1 text-sm font-medium text-ink">{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-14 lg:py-16">
    <div class="space-y-12 sm:space-y-14">
      <section>
        <h2 class="font-brand text-3xl text-earth">About {region.name}</h2>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-ink-muted sm:text-base">{region.intro}</p>
      </section>

      {/* Devotional and non-devotional places side by side; stacked on phones. */}
      <section aria-labelledby="dest-heading">
        <h2 id="dest-heading" class="font-brand flex items-center gap-2.5 text-2xl text-earth sm:text-3xl">
          <svg viewBox="0 0 20 20" class="h-5 w-5 shrink-0 text-saffron" aria-hidden="true"><path d={STAR_PATH} fill="currentColor" /></svg>
          Popular places to visit in {region.name}
        </h2>
        {/* Phones: a two-tab switch so each list is one short scroll. From md up both
            columns sit side by side and the switch is hidden. Without JS both show. */}
        <div class="mt-5 grid grid-cols-2 gap-1 rounded-full border border-line bg-sand p-1 md:hidden" role="tablist" data-place-tabs hidden>
          {placeGroups.map((group, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-place-tab={i} class="min-h-10 rounded-full px-3 text-xs font-semibold text-earth transition-colors aria-selected:bg-saffron aria-selected:text-on-saffron">
              {group.tab} ({group.places.length})
            </button>
          ))}
        </div>
        <div class="mt-5 grid items-start gap-5 md:mt-6 md:grid-cols-2 lg:gap-6">
          {placeGroups.map((group, i) => (
            <div class:list={['flex flex-col rounded-2xl border p-5 sm:p-7', group.tone]} data-place-panel={i}>
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-card text-saffron-deep shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true" set:html={group.icon} />
                </span>
                <div>
                  <h3 class="font-brand text-2xl text-earth">{group.title}</h3>
                  <p class="text-[11px] text-ink-muted">{group.subtitle} · {group.places.length} places</p>
                </div>
              </div>
              <ol class="mt-5 flex-1 space-y-4">
                {group.places.map((d, i) => (
                  <li class="flex gap-3 border-t border-line pt-4 first:border-t-0 first:pt-0">
                    <span class="font-brand flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-temple-gold text-xs text-temple-gold">{i + 1}</span>
                    <div>
                      <h4 class="text-sm font-semibold text-earth">{d.name}</h4>
                      <p class="mt-0.5 text-xs leading-relaxed text-ink-muted">{d.blurb}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>

      <CustomiseNote
        heading="Add as many places as you like"
        text={`These are just the popular picks for ${region.name}. Want a place that isn't listed, an extra town, more temples or a neighbouring state? Tell us and we'll add it — then plan the route, hotels and meals around everything you want to see.`}
        options={['Add places not listed here', 'Add a neighbouring state', 'More temples or more sightseeing', 'Extra days', 'Your dates', 'Hotel category', 'Your budget', 'Veg / Jain meals', 'Pace for elders & kids']}
      />

      <section aria-labelledby="highlights-heading" class="rounded-2xl bg-sand p-6 sm:p-8">
        <h2 id="highlights-heading" class="font-brand text-3xl text-earth">Sightseeing highlights</h2>
        <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {region.highlights.map((h) => (
            <li class="flex items-start gap-2.5 text-sm text-ink">
              <svg viewBox="0 0 20 20" class="mt-1 h-3 w-3 shrink-0 text-temple-gold" aria-hidden="true"><path d={STAR_PATH} fill="currentColor" /></svg>
              {h}
            </li>
          ))}
        </ul>
      </section>
    </div>

  </div>

  <section class="bg-earth py-12 sm:py-16">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <h2 class="font-brand text-3xl text-on-dark sm:text-4xl">Plan your {region.name} trip</h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-on-dark-muted">
          Tell us your dates, who's travelling and whether it's a pilgrimage, a holiday or both — we'll send a day-by-day plan and a quote, usually the same day.
        </p>
      </div>
      <ContactButtons tone="dark" message={`Hi Charrish Travels, I'd like to plan a trip to ${region.name}.`} />
    </div>
  </section>

  {nearby.length > 0 && (
    <section class="border-t border-line bg-sand/60 py-14 sm:py-16" aria-labelledby="nearby-heading">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 id="nearby-heading" class="font-brand text-3xl text-earth">More in {region.zone} India</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {nearby.map((r) => <RegionCard region={r} />)}
        </div>
      </div>
    </section>
  )}

  <nav aria-label={`Other ${kindLabel === 'State' ? 'states' : 'union territories'}`} class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-8 text-sm sm:px-6">
    <a href={regionHref(prev.slug)} class="max-w-[45%] text-earth hover:text-saffron-deep">← {prev.name}</a>
    <a href="/tours/domestic#states-heading" class="hidden text-xs text-ink-muted underline decoration-temple-gold underline-offset-4 hover:text-saffron-deep sm:inline">All states &amp; UTs</a>
    <a href={regionHref(next.slug)} class="max-w-[45%] text-right text-earth hover:text-saffron-deep">{next.name} →</a>
  </nav>

  <p class="mx-auto max-w-6xl px-4 pb-8 text-[11px] text-ink-muted sm:px-6">
    Photo: <a href={region.credit.sourceUrl} target="_blank" rel="noopener nofollow" class="underline">{region.credit.artist}</a>,{' '}
    {region.credit.licenseUrl ? <a href={region.credit.licenseUrl} target="_blank" rel="noopener nofollow" class="underline">{region.credit.license}</a> : region.credit.license}, via Wikimedia Commons
  </p>
</Layout>

<script>
  // Mobile tab switch between the Devotional and Sightseeing lists.
  const tabs = document.querySelector<HTMLElement>('[data-place-tabs]');
  if (tabs) {
    const buttons = Array.from(tabs.querySelectorAll<HTMLButtonElement>('[data-place-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-place-panel]'));
    const mq = window.matchMedia('(min-width: 48rem)');
    let active = 0;
    const render = () => {
      buttons.forEach((b, i) => b.setAttribute('aria-selected', String(i === active)));
      panels.forEach((p, i) => p.classList.toggle('max-md:hidden', i !== active));
    };
    tabs.hidden = false;
    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        active = i;
        render();
      }),
    );
    mq.addEventListener('change', render);
    render();
  }
</script>
