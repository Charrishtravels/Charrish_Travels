---
import { SITE } from '../consts';
---

<div class="fixed bottom-24 right-4 z-40 flex flex-col gap-3 sm:bottom-28 sm:right-6">
  <a
    href={`https://wa.me/${SITE.whatsapp}`}
    target="_blank"
    rel="noopener"
    aria-label="Chat on WhatsApp"
    class="flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-105"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-6 w-6" fill="currentColor">
      <path d="M16.004 2.667c-7.363 0-13.333 5.97-13.333 13.333 0 2.353.615 4.646 1.784 6.667L2.667 29.333l6.822-1.762a13.27 13.27 0 0 0 6.515 1.72h.006c7.363 0 13.333-5.97 13.333-13.333 0-3.56-1.387-6.907-3.906-9.427a13.24 13.24 0 0 0-9.433-3.864zm0 24.4h-.005a11.06 11.06 0 0 1-5.635-1.543l-.404-.24-4.05 1.046 1.082-3.947-.264-.406a11.03 11.03 0 0 1-1.694-5.877c0-6.114 4.977-11.09 11.095-11.09a11.03 11.03 0 0 1 7.844 3.253 11.02 11.02 0 0 1 3.247 7.845c0 6.115-4.978 11.09-11.095 11.09z"/>
      <path d="M22.02 18.617c-.33-.165-1.955-.965-2.258-1.076-.303-.11-.523-.165-.744.166-.22.33-.853 1.075-1.046 1.296-.193.22-.386.248-.716.083-.33-.165-1.393-.513-2.653-1.636-.981-.875-1.643-1.956-1.836-2.287-.193-.33-.02-.508.145-.673.149-.148.33-.386.496-.579.165-.193.22-.33.33-.55.11-.221.055-.414-.028-.58-.083-.165-.744-1.794-1.02-2.456-.269-.645-.542-.558-.744-.568l-.634-.011c-.22 0-.578.083-.881.414-.303.33-1.156 1.13-1.156 2.757s1.184 3.199 1.349 3.42c.165.22 2.331 3.56 5.65 4.99.789.34 1.405.543 1.885.695.792.252 1.513.216 2.083.131.635-.095 1.955-.8 2.23-1.572.276-.772.276-1.434.193-1.572-.083-.138-.303-.22-.634-.386z"/>
    </svg>
  </a>
  <a
    href={`tel:${SITE.phone}`}
    aria-label="Call us"
    class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-800 text-white shadow-lg transition-transform hover:scale-105"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 0 1 2-2h2.28a1 1 0 0 1 .948.684l1.498 4.493a1 1 0 0 1-.502 1.21l-2.257 1.13a11 11 0 0 0 5.516 5.516l1.13-2.257a1 1 0 0 1 1.21-.502l4.493 1.498a1 1 0 0 1 .684.949V19a2 2 0 0 1-2 2h-1C9.716 21 3 14.284 3 6z" />
    </svg>
  </a>
</div>
