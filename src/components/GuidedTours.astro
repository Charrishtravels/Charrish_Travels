---
import { Image } from 'astro:assets';
import guidedTourHeritage from '../assets/guided-tour-heritage.jpg';

const FEATURES = [
  { n: '01', title: 'Professional & Local Guides' },
  { n: '02', title: 'Heritage Tours' },
  { n: '03', title: 'Cultural Tours' },
  { n: '04', title: 'Temple Guides' },
  { n: '05', title: 'Destination Experiences' },
];
---

<div class="overflow-hidden rounded-2xl border border-black/10 p-6 sm:p-8 lg:p-10">
  <div class="grid gap-10 lg:grid-cols-[2fr_3fr] lg:items-center lg:gap-16">
    <div class="relative order-2 mx-auto w-full max-w-[16rem] sm:max-w-[18rem] lg:order-1" data-reveal="zoom" style="--reveal-delay: 120ms">
      <div class="absolute -inset-3 -z-10 hidden rotate-2 rounded-3xl border border-gold-300/60 sm:block"></div>
      <div class="relative -rotate-2 overflow-hidden rounded-2xl border-8 border-white shadow-xl">
        <Image
          src={guidedTourHeritage}
          alt="Travellers exploring a heritage site with a local guide"
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 35vw, 90vw"
          class="aspect-[3/4] w-full object-cover"
        />
      </div>
      <p class="font-brand mt-6 rotate-1 text-center text-sm text-emerald-800/70 sm:text-base">
        "Every stone has a story — we make sure you hear it."
      </p>
    </div>

    <div class="order-1 lg:order-2" data-reveal="up">
      <h3 class="font-brand text-2xl leading-tight text-emerald-950 sm:text-3xl">
        Discover More With Local Experts
      </h3>
      <p class="mt-3 text-xs leading-relaxed text-black sm:text-sm">
        Make your journey more meaningful with experienced local guides who know the history,
        culture and stories behind every destination — for families, couples, groups and
        special-interest travellers alike.
      </p>

      <ul class="mt-6 flex flex-wrap gap-2 border-t border-black/10 pt-5">
        {FEATURES.map((f, i) => (
          <li
            class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-black/[0.02] px-3 py-1.5 text-xs font-medium text-emerald-950"
            data-reveal="left"
            style={`--reveal-delay: ${380 + i * 90}ms`}
          >
            <span class="font-brand text-sm text-gold-500">{f.n}</span>
            {f.title}
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
