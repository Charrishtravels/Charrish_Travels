<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
  const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-dot]'));
  const track = document.getElementById('carousel-track');
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    const nextIndex = (index + slides.length) % slides.length;
    if (nextIndex === current) return;

    slides[current]?.classList.replace('opacity-100', 'opacity-0');
    dots[current]?.classList.replace('w-6', 'w-1.5');
    dots[current]?.classList.replace('bg-white', 'bg-white/50');

    current = nextIndex;

    slides[current]?.classList.replace('opacity-0', 'opacity-100');
    dots[current]?.classList.replace('w-1.5', 'w-6');
    dots[current]?.classList.replace('bg-white/50', 'bg-white');
  }

  function restartTimer() {
    clearInterval(timer);
    timer = setInterval(() => goTo(current + 1), 5000);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      goTo(i);
      restartTimer();
    });
  });

  let touchStartX = 0;
  track?.addEventListener(
    'touchstart',
    (e) => {
      touchStartX = e.touches[0].clientX;
    },
    { passive: true }
  );
  track?.addEventListener(
    'touchend',
    (e) => {
      const delta = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(delta) > 40) {
        goTo(current + (delta < 0 ? 1 : -1));
        restartTimer();
      }
    },
    { passive: true }
  );

  if (slides.length > 1) restartTimer();

  const pinWrap = document.getElementById('hero-pin');
  const photo = document.getElementById('hero-photo');
  const photoTrack = document.getElementById('carousel-track');
  const photoTint = document.getElementById('hero-photo-tint');
  const content = document.getElementById('hero-content');
  const dotsWrap = document.getElementById('hero-dots');
  const reveal = document.getElementById('hero-reveal');

  if (reveal) {
    reveal.style.opacity = '0';

    // The logo is split into four parts (crescent, star + sun, water, plane) plus
    // the wordmark, each animating in on its own staggered delay (see .logo-part-*
    // and .logo-name in <style>). Only advance to the idle "settled" bob once the
    // last piece (the name) lands.
    reveal.addEventListener('animationend', (e) => {
      const target = e.target as HTMLElement;
      if (e.animationName === 'logo-name-in' && target.classList.contains('logo-name') && revealed) {
        reveal.classList.remove('is-revealing');
        reveal.classList.add('is-settled');
      }
    });
  }
  let revealed = false;
  const REVEAL_THRESHOLD = 0.55;

  function updateHeroScroll() {
    if (!pinWrap) return;
    const scrollable = pinWrap.offsetHeight - window.innerHeight;
    const rect = pinWrap.getBoundingClientRect();
    const progress = scrollable > 0 ? Math.min(Math.max(-rect.top / scrollable, 0), 1) : 0;

    if (photo) {
      photo.style.transform = `scale(${1 - progress * 0.45})`;
      photo.style.borderRadius = `${progress * 16}px`;
    }
    // Fade the photo itself out rather than covering it with a cream layer: at
    // fractional scale values the two layers antialias independently, which let a
    // sliver of the dark tint bleed past the cover and drew a visible rectangle.
    const photoOpacity = String(1 - Math.min(progress / 0.6, 1));
    if (photoTrack) photoTrack.style.opacity = photoOpacity;
    if (photoTint) photoTint.style.opacity = photoOpacity;

    const chromeOpacity = 1 - Math.min(progress / 0.3, 1);
    if (content) content.style.opacity = String(chromeOpacity);
    if (dotsWrap) dotsWrap.style.opacity = String(chromeOpacity);

    if (reveal) {
      const shouldReveal = progress >= REVEAL_THRESHOLD;
      if (shouldReveal !== revealed) {
        revealed = shouldReveal;
        reveal.classList.remove('is-settled');
        if (revealed) {
          reveal.style.opacity = '1';
          reveal.classList.add('is-revealing');
        } else {
          reveal.classList.remove('is-revealing');
          reveal.style.opacity = '0';
        }
      }
    }
  }

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateHeroScroll();
          ticking = false;
        });
        ticking = true;
      }
    },
    { passive: true }
  );

  updateHeroScroll();
</script>

<style>
  /* Each logo part grows in from its own center, in sequence: crescent, then
     star + sun, then water, then plane. */
  .logo-part {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  #hero-reveal.is-revealing .logo-part-crescent {
    animation: logo-part-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0s;
  }

  #hero-reveal.is-revealing .logo-part-starsun {
    animation: logo-part-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0.28s;
  }

  #hero-reveal.is-revealing .logo-part-water {
    animation: logo-part-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0.56s;
  }

  #hero-reveal.is-revealing .logo-part-plane {
    animation: logo-part-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0.84s;
  }

  #hero-reveal.is-settled .logo-part {
    opacity: 1;
    transform: none;
  }

  /* The wordmark lands last, right after the plane. */
  .logo-name {
    opacity: 0;
    transform: translateY(8px);
  }

  #hero-reveal.is-revealing .logo-name {
    animation: logo-name-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 1.12s;
  }

  #hero-reveal.is-settled .logo-name {
    opacity: 1;
    transform: none;
  }

  #hero-reveal.is-settled {
    animation: hero-logo-bob 3.6s ease-in-out infinite;
  }

  @keyframes logo-part-in {
    0% {
      opacity: 0;
      transform: scale(0.5);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes logo-name-in {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-logo-bob {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(0, -6px);
    }
  }
</style>
