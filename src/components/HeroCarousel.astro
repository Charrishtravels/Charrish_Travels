---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../consts';

interface Slide {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<div id="hero-pin" class="relative h-[180vh] sm:h-[200vh] lg:h-[220vh]">
  <section class="sticky top-0 h-svh w-full overflow-hidden bg-cream">
    <div id="hero-photo" class="absolute inset-0 origin-center overflow-hidden">
      <div id="carousel-track" class="absolute inset-0">
        {slides.map((slide, i) => (
          <Image
            src={slide.src}
            alt={slide.alt}
            widths={[640, 1024, 1600, 2048]}
            sizes="100vw"
            data-slide
            loading={i === 0 ? 'eager' : 'lazy'}
            class:list={[
              'absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ease-in-out',
              i === 0 ? 'opacity-100' : 'opacity-0',
            ]}
          />
        ))}
      </div>

      <div id="hero-photo-tint" class="absolute inset-0 bg-gradient-to-b from-stone-950/78 via-stone-950/70 to-stone-950/82"></div>
    </div>

    <div id="hero-content" class="relative z-10 flex h-full w-full flex-col items-center justify-center px-4 text-center text-white [text-shadow:0_2px_12px_rgb(0_0_0_/_0.45)]">
      <div class="flex w-full max-w-2xl flex-col items-center">
        <slot />
      </div>
    </div>

    {slides.length > 1 && (
      <div id="hero-dots" class="absolute bottom-6 left-1/2 z-10 flex -translate-x-1/2 gap-5">
        {slides.map((_, i) => (
          <button
            type="button"
            data-dot
            aria-label={`Go to slide ${i + 1}`}
            class:list={[
              // ::after widens the tap target to ~26x30 without changing the dot's look
              "relative h-1.5 rounded-full transition-all duration-300 after:absolute after:-inset-x-2.5 after:-inset-y-3 after:content-['']",
              i === 0 ? 'w-6 bg-white' : 'w-1.5 bg-white/50',
            ]}
          ></button>
        ))}
      </div>
    )}

    <div id="hero-reveal" class="pointer-events-none absolute inset-0 z-20 flex flex-col items-center justify-center px-4 text-center text-white opacity-0">
      <svg viewBox="0 0 1254 1254" xmlns="http://www.w3.org/2000/svg" class="h-44 w-auto sm:h-60" aria-hidden="true">
<g class="logo-part logo-part-crescent">
