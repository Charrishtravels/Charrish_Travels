---
import { Image } from 'astro:assets';
import transportSuv from '../assets/transportation-suv.jpg';

const FLEET = ['Cars', 'SUVs', 'Tempo Travellers', 'Force Urbania', 'Coaches'];
const SERVICES = ['Airport Transfers', 'Intercity Transportation', 'Local Sightseeing Transportation'];

const ROUTE = [
  { label: 'Pickup', icon: '<path d="M2 16l20-8-9 9M2 16l4 6 5-7M2 16l7-2" />' },
  { label: 'Sightseeing', icon: '<circle cx="12" cy="13" r="3.5" /><path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z" />' },
  { label: 'Intercity', icon: '<path d="M3 16.5V13l2-5h10l2 5v3.5" /><circle cx="7" cy="16.5" r="1.5" /><circle cx="17" cy="16.5" r="1.5" /><path d="M3 13h16" />' },
  { label: 'Drop-off', icon: '<path d="M22 16l-20 8 9-9M22 16l-4-6-5 7M22 16l-7 2" />' },
];
---

<div class="overflow-hidden rounded-2xl border border-line bg-card p-6 sm:p-8 lg:p-10">
  {/* Uneven columns: the visual is deliberately small, so giving it a full half
      left a dead band beside it. The text takes the surplus instead. */}
  <div class="grid gap-10 lg:grid-cols-[3fr_2fr] lg:items-center lg:gap-16">
    <div class="order-1" data-reveal="up">
      <h3 class="font-brand text-2xl leading-tight text-earth sm:text-3xl">Transportation Isn't an Add-On</h3>
      <p class="mt-3 text-xs leading-relaxed text-ink-muted sm:text-sm">
        Strong destination-wise transportation arrangements, planned before you land. From a
        private sedan for two to a full coach for a group, we match the vehicle to your itinerary
        and take the logistics off your plate entirely.
      </p>

      {/* Pills rather than a two-column grid: the labels vary a lot in length, and
          in a grid the long ones wrapped while the short ones didn't, breaking the
          row rhythm. Pills size to their text and wrap as whole units. */}
      <div class="mt-6 space-y-5 border-t border-line pt-5">
        <div>
          <p class="text-[11px] font-semibold tracking-[0.2em] text-maroon uppercase">Our Fleet</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {FLEET.map((item) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-line bg-page px-3 py-1.5 text-xs text-ink">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-temple-gold"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="text-[11px] font-semibold tracking-[0.2em] text-maroon uppercase">Services</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {SERVICES.map((item) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-line bg-page px-3 py-1.5 text-xs text-ink">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-temple-gold"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="order-2" data-reveal="right" style="--reveal-delay: 120ms">
      <div class="relative mx-auto aspect-[3/4] w-full max-w-[16rem] overflow-hidden rounded-2xl sm:max-w-[18rem]">
        <Image
          src={transportSuv}
          alt="Comfortable SUV travelling on a scenic road"
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 35vw, 90vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-page/95 via-page/20 to-transparent"></div>

        <div class="absolute inset-x-0 bottom-0 px-3 pb-5 pt-10 sm:px-4">
          <div class="relative">
            <div class="absolute left-[10%] right-[10%] top-4 border-t-2 border-dashed border-temple-gold/50"></div>
            <div class="relative grid grid-cols-4 gap-1">
              {ROUTE.map((stop, i) => (
                <div
                  class="flex flex-col items-center gap-1.5 text-center"
                  data-reveal="zoom"
                  style={`--reveal-delay: ${450 + i * 110}ms`}
                >
                  <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-temple-gold bg-card text-temple-gold sm:h-8 sm:w-8">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" set:html={stop.icon} />
                  </div>
                  <p class="text-[8px] font-semibold tracking-tight text-earth uppercase sm:text-[9px] sm:tracking-normal">{stop.label}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
