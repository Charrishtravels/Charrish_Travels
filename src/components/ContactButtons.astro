---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { SITE } from '../consts';

interface Props {
  /** Pre-filled WhatsApp message. */
  message: string;
  /** 'light' for pale backgrounds, 'dark' for the earth-brown band. */
  tone?: 'light' | 'dark';
}

const { message, tone = 'light' } = Astro.props;
const whatsappHref = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(message)}`;
---

{/* Full-width stacked buttons on phones (easy thumb targets), side by side from sm up. */}
<div class="flex flex-col gap-3 sm:flex-row">
  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener"
    class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#25D366] px-7 py-3 text-sm font-semibold text-earth shadow-lg transition-all duration-200 hover:scale-105 active:scale-95"
  >
    <WhatsAppIcon class="h-5 w-5" />
    Chat on WhatsApp
  </a>
  <a
    href={`tel:${SITE.phone.replace(/\s/g, '')}`}
    class:list={[
      'inline-flex min-h-12 items-center justify-center gap-2 rounded-full border px-7 py-3 text-sm font-semibold shadow-lg transition-all duration-200 hover:scale-105 active:scale-95',
      tone === 'dark' ? 'border-temple-gold/60 bg-earth-deep text-on-dark' : 'border-line bg-card text-earth',
    ]}
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 0 1 2-2h2.28a1 1 0 0 1 .948.684l1.498 4.493a1 1 0 0 1-.502 1.21l-2.257 1.13a11 11 0 0 0 5.516 5.516l1.13-2.257a1 1 0 0 1 1.21-.502l4.493 1.498a1 1 0 0 1 .684.949V19a2 2 0 0 1-2 2h-1C9.716 21 3 14.284 3 6z" />
    </svg>
    Call {SITE.phone}
  </a>
</div>
