---
const STATS = [
  { value: '200+', label: 'Packages curated' },
  { value: '20+', label: 'Years of experience' },
  { value: '5,000+', label: 'Happy travellers' },
  { value: '4.8★', label: 'Average rating' },
];
---

<section id="credentials" class="border-b border-emerald-100 bg-emerald-800">
  <div class="mx-auto grid max-w-5xl grid-cols-2 gap-6 px-4 py-10 sm:grid-cols-4 sm:px-6">
    {STATS.map((stat) => (
      <div class="text-center">
        <p class="font-brand text-2xl text-white sm:text-3xl">{stat.value}</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-white/70 sm:text-sm">{stat.label}</p>
      </div>
    ))}
  </div>
</section>
