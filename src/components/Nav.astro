---
import { SITE } from '../consts';

const NAV_LINKS = [
  { href: '/about', label: 'About us' },
  { href: '/destinations', label: 'Packages' },
  { href: '/testimonials', label: 'Reviews' },
];

const currentPath = Astro.url.pathname;

const linkClass = (href: string) =>
  [
    'inline-block rounded-full px-3 py-1.5 text-black transition-all duration-200 hover:scale-105 hover:bg-emerald-50 active:scale-95',
    currentPath === href ? 'bg-emerald-100 font-semibold' : '',
  ].join(' ');
---

<header class="sticky top-0 z-50 flex h-12 items-stretch border-b border-emerald-100 bg-cream">
  <div class="flex flex-1 items-stretch justify-between gap-6 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2">
      <img src={SITE.logo} alt={SITE.name} class="h-7 w-auto" />
    </a>

    <ul class="hidden flex-1 items-center justify-end gap-2 text-xs font-medium sm:flex">
      {NAV_LINKS.map((link) => (
        <li>
          <a href={link.href} class={linkClass(link.href)}>{link.label}</a>
        </li>
      ))}
    </ul>

    <button
      id="nav-toggle"
      class="flex h-10 w-10 shrink-0 items-center justify-self-end self-center rounded-md text-black sm:hidden"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <a
    href="/contact"
    class="hidden shrink-0 items-center justify-center bg-emerald-800 px-6 text-xs font-semibold text-white transition-all duration-200 hover:scale-105 hover:bg-emerald-900 active:scale-95 sm:flex"
  >
    Contact us
  </a>

  <ul id="nav-menu" class="hidden flex-col gap-1 border-t border-emerald-100 px-4 pb-4 text-xs font-medium text-black sm:hidden">
    {[...NAV_LINKS, { href: '/contact', label: 'Contact us' }].map((link) => (
      <li>
        <a
          href={link.href}
          class:list={[
            'block rounded-md px-2 py-2.5 transition-all duration-200 hover:bg-emerald-50 active:scale-95',
            currentPath === link.href && 'bg-emerald-100 font-semibold',
          ]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('flex');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
