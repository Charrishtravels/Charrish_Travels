---
import { SITE, TOUR_CATEGORIES } from '../consts';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const NAV_LINKS = [
  { href: '/about', label: 'About us' },
  {
    href: '/tours',
    label: 'Tours',
    children: TOUR_CATEGORIES.map((c) => ({ href: `/tours/${c.slug}`, label: c.label })),
  },
  { href: '/testimonials', label: 'Reviews' },
];

const currentPath = Astro.url.pathname;

// A section stays highlighted on its child pages too, so Tours reads as active
// while you're on /tours/temple or a tour's own page.
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');

const linkClass = (href: string) =>
  [
    'flex h-full items-center rounded-b-xl px-4 transition-all duration-200 active:scale-95',
    transparent ? 'text-white hover:bg-white/10' : 'text-earth hover:bg-sand hover:text-saffron-deep',
    isActive(href) ? (transparent ? 'bg-white/15 font-semibold' : 'bg-sand font-semibold text-saffron-deep') : '',
  ].join(' ');
---

<header class:list={['top-0 z-50 flex h-12 items-stretch transition-colors duration-300', transparent ? 'nav-transparent fixed inset-x-0 border-transparent bg-transparent' : 'sticky border-b border-line bg-page']}>
  <div class="flex flex-1 items-stretch justify-between gap-6 pl-4 pr-4 sm:pl-6 sm:pr-0">
    <a href="/" class="flex shrink-0 items-center">
      <p
        data-logo-text
        class:list={[
          'font-brand whitespace-nowrap text-xs uppercase tracking-[0.25em] sm:text-sm sm:tracking-[0.35em]',
          transparent ? 'text-white' : 'text-earth',
        ]}
      >
        {SITE.name}
      </p>
    </a>

    <ul id="nav-links" class="hidden flex-1 items-stretch justify-end text-xs font-medium sm:flex">
      {NAV_LINKS.map((link) => (
        <li class:list={['flex', link.children && 'group relative']}>
          <a href={link.href} class={linkClass(link.href)}>
            {link.label}
            {link.children && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="ml-1.5 h-3 w-3 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
              </svg>
            )}
          </a>
          {link.children && (
            <div class="invisible absolute top-full right-0 w-56 translate-y-1 overflow-hidden rounded-b-xl border border-line border-t-0 bg-page opacity-0 shadow-lg transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
              <ul class="py-1.5">
                {link.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class:list={[
                        'block px-4 py-2.5 text-xs text-earth transition-colors hover:bg-sand hover:text-saffron-deep',
                        currentPath === child.href && 'bg-sand font-semibold text-saffron-deep',
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))}
    </ul>

    <button
      id="nav-toggle"
      class:list={['flex h-10 w-10 shrink-0 items-center justify-self-end self-center rounded-md sm:hidden', transparent ? 'text-white' : 'text-earth']}
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <a
    href={`https://wa.me/${SITE.whatsapp}`}
    target="_blank"
    rel="noopener"
    data-nav-cta
    class="hidden shrink-0 items-center justify-center rounded-bl-xl bg-saffron px-7 text-xs font-semibold text-on-saffron transition-all duration-200 hover:bg-saffron-deep active:scale-95 sm:flex"
  >
    Contact us
  </a>

  <ul
    id="nav-menu"
    class:list={[
      'absolute inset-x-0 top-full flex max-h-0 flex-col overflow-hidden rounded-b-2xl text-base font-medium opacity-0 shadow-lg transition-all duration-300 ease-in-out sm:hidden',
      transparent ? 'divide-y divide-line border-t border-line bg-page text-earth' : 'divide-y divide-line border-t border-line bg-page text-earth',
    ]}
  >
    {[...NAV_LINKS, { href: `https://wa.me/${SITE.whatsapp}`, label: 'Contact us', children: undefined }].map((link) => (
      <li>
        <a
          href={link.href}
          class:list={[
            'block px-5 py-4 transition-all duration-200 active:scale-95',
            transparent ? 'hover:bg-sand hover:text-saffron-deep' : 'hover:bg-sand hover:text-saffron-deep',
            currentPath === link.href && (transparent ? 'bg-sand font-semibold text-saffron-deep' : 'bg-sand font-semibold text-saffron-deep'),
          ]}
        >
          {link.label}
        </a>
        {link.children && (
          <ul class:list={['text-sm', transparent ? 'bg-sand/40' : 'bg-sand/40']}>
            {link.children.map((child) => (
              <li>
                <a
                  href={child.href}
                  class:list={[
                    'block py-3 pr-5 pl-9 transition-all duration-200 active:scale-95',
                    transparent ? 'hover:bg-sand hover:text-saffron-deep' : 'hover:bg-sand hover:text-saffron-deep',
                    currentPath === child.href && (transparent ? 'bg-sand font-semibold text-saffron-deep' : 'bg-sand font-semibold text-saffron-deep'),
                  ]}
                >
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</header>

{transparent && (
  <style>
    header.nav-transparent.nav-scrolled {
      background-color: var(--color-page);
      border-color: var(--color-line);
    }
    /* The Contact us button keeps its own saffron-and-white colours once scrolled. */
    header.nav-transparent.nav-scrolled a:not([data-nav-cta]),
    header.nav-transparent.nav-scrolled #nav-toggle,
    header.nav-transparent.nav-scrolled #nav-menu {
      color: var(--color-earth);
    }
    header.nav-transparent.nav-scrolled a:not([data-nav-cta]):hover {
      background-color: var(--color-sand);
      color: var(--color-saffron-deep);
    }
    header.nav-transparent.nav-scrolled #nav-links a.font-semibold,
    header.nav-transparent.nav-scrolled #nav-menu a.font-semibold {
      background-color: var(--color-sand);
      color: var(--color-saffron-deep);
    }
    header.nav-transparent.nav-scrolled #nav-menu {
      border-color: var(--color-line);
      background-color: var(--color-page);
    }
    /* While the header floats over the hero photos, a faint dark fade and a soft
       shadow keep the white text readable on bright skies as well as dark scenes. */
    header.nav-transparent:not(.nav-scrolled) {
      background-image: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-earth) 70%, transparent),
        color-mix(in srgb, var(--color-earth) 45%, transparent) 60%,
        transparent
      );
    }
    header.nav-transparent:not(.nav-scrolled) [data-logo-text],
    header.nav-transparent:not(.nav-scrolled) #nav-links > li > a {
      text-shadow:
        0 1px 2px color-mix(in srgb, var(--color-earth) 85%, transparent),
        0 0 14px color-mix(in srgb, var(--color-earth) 65%, transparent);
    }
    header.nav-transparent:not(.nav-scrolled) #nav-toggle {
      filter: drop-shadow(0 1px 2px color-mix(in srgb, var(--color-earth) 70%, transparent));
    }
    header.nav-transparent [data-logo-text] {
      color: var(--color-white);
      transition: color 0.3s ease;
    }
    header.nav-transparent.nav-scrolled [data-logo-text] {
      color: var(--color-earth);
    }
  </style>
)}

<script>
  const header = document.querySelector('header');
  const heroPin = document.getElementById('hero-pin');

  if (header?.classList.contains('nav-transparent') && heroPin) {
    // Switch to the solid/dark-text nav once the hero's own scroll-dim overlay has
    // washed the photo mostly light — not only once the whole pin has scrolled past —
    // since the background under the nav turns light well before that point.
    const NAV_SOLID_THRESHOLD = 0.28;

    function updateNavScrolled() {
      const scrollable = heroPin!.offsetHeight - window.innerHeight;
      const rect = heroPin!.getBoundingClientRect();
      const progress = scrollable > 0 ? Math.min(Math.max(-rect.top / scrollable, 0), 1) : 0;
      const pastPin = rect.bottom <= header!.offsetHeight;
      header!.classList.toggle('nav-scrolled', progress >= NAV_SOLID_THRESHOLD || pastPin);
    }

    let navTicking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!navTicking) {
          requestAnimationFrame(() => {
            updateNavScrolled();
            navTicking = false;
          });
          navTicking = true;
        }
      },
      { passive: true }
    );

    updateNavScrolled();
  }

  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  toggle?.addEventListener('click', () => {
    const willOpen = menu?.classList.contains('max-h-0');
    menu?.classList.toggle('max-h-0', !willOpen);
    menu?.classList.toggle('opacity-0', !willOpen);
    menu?.classList.toggle('max-h-[34rem]', willOpen);
    menu?.classList.toggle('opacity-100', willOpen);
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(Boolean(willOpen)));
  });
</script>
