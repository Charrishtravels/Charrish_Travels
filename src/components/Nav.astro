---
import { SITE } from '../consts';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const NAV_LINKS = [
  { href: '/about', label: 'About us' },
  { href: '/destinations', label: 'Packages' },
  { href: '/testimonials', label: 'Reviews' },
];

const currentPath = Astro.url.pathname;

const linkClass = (href: string) =>
  [
    'flex h-full items-center rounded-b-xl px-4 transition-all duration-200 active:scale-95',
    transparent ? 'text-white hover:bg-white/10' : 'text-black hover:bg-gold-100',
    currentPath === href ? (transparent ? 'bg-white/15 font-semibold' : 'bg-gold-200 font-semibold') : '',
  ].join(' ');
---

<header class:list={['top-0 z-50 flex h-12 items-stretch transition-colors duration-300', transparent ? 'nav-transparent fixed inset-x-0 border-transparent bg-transparent' : 'sticky border-b border-gold-200/60 bg-cream']}>
  <div class="flex flex-1 items-stretch justify-between gap-6 pl-4 pr-4 sm:pl-6 sm:pr-0">
    <a href="/" class="flex shrink-0 items-center">
      <p
        data-logo-text
        class:list={[
          'font-brand whitespace-nowrap text-xs uppercase tracking-[0.25em] sm:text-sm sm:tracking-[0.35em]',
          transparent ? 'text-white' : 'text-emerald-950',
        ]}
      >
        {SITE.name}
      </p>
    </a>

    <ul id="nav-links" class="hidden flex-1 items-stretch justify-end text-xs font-medium sm:flex">
      {NAV_LINKS.map((link) => (
        <li class="flex">
          <a href={link.href} class={linkClass(link.href)}>{link.label}</a>
        </li>
      ))}
    </ul>

    <button
      id="nav-toggle"
      class:list={['flex h-10 w-10 shrink-0 items-center justify-self-end self-center rounded-md sm:hidden', transparent ? 'text-white' : 'text-black']}
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <a
    href={`https://wa.me/${SITE.whatsapp}`}
    target="_blank"
    rel="noopener"
    data-nav-cta
    class="hidden shrink-0 items-center justify-center rounded-bl-xl bg-emerald-950 px-7 text-xs font-semibold text-gold-400 transition-all duration-200 hover:bg-emerald-900 active:scale-95 sm:flex"
  >
    Contact us
  </a>

  <ul
    id="nav-menu"
    class:list={[
      'absolute inset-x-0 top-full flex max-h-0 flex-col overflow-hidden rounded-b-2xl text-base font-medium opacity-0 shadow-lg transition-all duration-300 ease-in-out sm:hidden',
      transparent ? 'divide-y divide-white/10 border-t border-white/20 bg-emerald-950/95 text-white' : 'divide-y divide-gold-200/60 border-t border-gold-200/60 bg-cream text-black',
    ]}
  >
    {[...NAV_LINKS, { href: `https://wa.me/${SITE.whatsapp}`, label: 'Contact us' }].map((link) => (
      <li>
        <a
          href={link.href}
          class:list={[
            'block px-5 py-4 transition-all duration-200 active:scale-95',
            transparent ? 'hover:bg-white/10' : 'hover:bg-gold-100',
            currentPath === link.href && (transparent ? 'bg-white/15 font-semibold' : 'bg-gold-200 font-semibold'),
          ]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</header>

{transparent && (
  <style>
    header.nav-transparent.nav-scrolled {
      background-color: var(--color-cream);
      border-color: color-mix(in srgb, var(--color-gold-200) 60%, transparent);
    }
    /* The Contact us button keeps its own green-and-gold colours once scrolled. */
    header.nav-transparent.nav-scrolled a:not([data-nav-cta]),
    header.nav-transparent.nav-scrolled #nav-toggle,
    header.nav-transparent.nav-scrolled #nav-menu {
      color: #000;
    }
    header.nav-transparent.nav-scrolled a:not([data-nav-cta]):hover {
      background-color: var(--color-gold-100);
    }
    header.nav-transparent.nav-scrolled #nav-links a.font-semibold,
    header.nav-transparent.nav-scrolled #nav-menu a.font-semibold {
      background-color: var(--color-gold-200);
    }
    header.nav-transparent.nav-scrolled #nav-menu {
      border-color: color-mix(in srgb, var(--color-gold-200) 60%, transparent);
      background-color: var(--color-cream);
    }
    header.nav-transparent [data-logo-text] {
      color: #fff;
      transition: color 0.3s ease;
    }
    header.nav-transparent.nav-scrolled [data-logo-text] {
      color: #000;
    }
  </style>
)}

<script>
  const header = document.querySelector('header');
  const heroPin = document.getElementById('hero-pin');

  if (header?.classList.contains('nav-transparent') && heroPin) {
    // Switch to the solid/dark-text nav once the hero's own scroll-dim overlay has
    // washed the photo mostly light — not only once the whole pin has scrolled past —
    // since the background under the nav turns light well before that point.
    const NAV_SOLID_THRESHOLD = 0.28;

    function updateNavScrolled() {
      const scrollable = heroPin!.offsetHeight - window.innerHeight;
      const rect = heroPin!.getBoundingClientRect();
      const progress = scrollable > 0 ? Math.min(Math.max(-rect.top / scrollable, 0), 1) : 0;
      const pastPin = rect.bottom <= header!.offsetHeight;
      header!.classList.toggle('nav-scrolled', progress >= NAV_SOLID_THRESHOLD || pastPin);
    }

    let navTicking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!navTicking) {
          requestAnimationFrame(() => {
            updateNavScrolled();
            navTicking = false;
          });
          navTicking = true;
        }
      },
      { passive: true }
    );

    updateNavScrolled();
  }

  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  toggle?.addEventListener('click', () => {
    const willOpen = menu?.classList.contains('max-h-0');
    menu?.classList.toggle('max-h-0', !willOpen);
    menu?.classList.toggle('opacity-0', !willOpen);
    menu?.classList.toggle('max-h-96', willOpen);
    menu?.classList.toggle('opacity-100', willOpen);
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(Boolean(willOpen)));
  });
</script>
