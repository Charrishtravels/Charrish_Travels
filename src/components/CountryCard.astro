---
import { Image } from 'astro:assets';
import { countryHref, type CountryWithPhoto } from '../data/world';

interface Props {
  country: CountryWithPhoto;
}

const { country } = Astro.props;
const d = country.details;
const searchText = [
  country.name,
  country.continent,
  country.region,
  ...country.places,
  ...(d?.destinations.map((x) => x.name) ?? []),
  ...(d?.devotional.map((x) => x.name) ?? []),
]
  .join(' ')
  .toLowerCase();
---

{/* Same shape as the Indian state cards, so both directories read alike. */}
<a
  href={countryHref(country.slug)}
  data-region-card
  data-zone={country.continent}
  data-search={searchText}
  class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-card shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-temple-gold hover:shadow-xl focus-visible:border-saffron"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-sand">
    <Image
      src={country.photo}
      alt={country.photoAlt}
      widths={[400, 640, 900]}
      sizes="(min-width: 1280px) 300px, (min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    {/* Sub-region label (Middle East, East Asia…); skipped when it just repeats the continent. */}
    {country.region !== country.continent && (
      <span class="absolute top-3 left-3 rounded-full bg-page/90 px-2.5 py-1 text-[10px] font-semibold tracking-wider text-maroon uppercase">
        {country.region}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-brand text-2xl text-earth">{country.name}</h3>
    <p class="mt-1 text-xs leading-snug text-ink-muted">{country.tagline}</p>

    {d && (
      <p class="mt-3 text-[11px] font-medium text-maroon">{d.destinations.length + d.devotional.length} places to visit</p>
    )}

    <ul class="mt-3 flex flex-wrap gap-1.5" aria-label={`Popular places in ${country.name}`}>
      {country.places.slice(0, 5).map((p) => (
        <li class="rounded-full bg-sand px-2.5 py-1 text-[11px] text-ink">{p}</li>
      ))}
    </ul>

    <p class="mt-auto pt-5 text-[11px] font-semibold tracking-wide text-saffron-deep uppercase">
      Explore {country.name.replace(/ \(.*\)$/, '')} <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span>
    </p>
  </div>
</a>
