---
const STEPS = [
  'Visa Processing',
  'Documentation Assistance',
  'Application Assistance',
  'Appointment Guidance',
  'Multi-Country Visa Assistance',
];

// 8-point compass star matching the logo's star mark, reused as the ink-stamp motif
const STAR_PATH =
  'M10 0 L10.77 8.15 L14.24 5.76 L11.85 9.23 L20 10 L11.85 10.77 L14.24 14.24 L10.77 11.85 L10 20 L9.23 11.85 L5.76 14.24 L8.15 10.77 L0 10 L8.15 9.23 L5.76 5.76 L9.23 8.15 Z';
---

<div class="overflow-hidden rounded-2xl border border-line bg-card p-6 sm:p-8 lg:p-10">
  <div class="grid gap-10 lg:grid-cols-[2fr_3fr] lg:items-center lg:gap-16">
    <div class="order-1 lg:order-2" data-reveal="up">
      <h3 class="font-brand text-2xl leading-tight text-earth sm:text-3xl">
        Visa Assistance, Stamp to Stamp
      </h3>
      <p class="mt-3 text-xs leading-relaxed text-ink-muted sm:text-sm">
        Visa requirements vary by country and change often — we stay on top of both, so paperwork
        never stalls an international trip, whether it's a single destination or a multi-country
        itinerary.
      </p>

      <ul class="mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
        {STEPS.map((step, i) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-page py-1.5 pr-3.5 pl-1.5 text-xs font-medium text-ink">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-maroon text-[10px] font-semibold text-on-dark">
              {i + 1}
            </span>
            {step}
          </li>
        ))}
      </ul>
    </div>

    <div class="order-2 lg:order-1" data-reveal="left" style="--reveal-delay: 120ms">
      <div class="relative mx-auto aspect-[3/4] w-full max-w-[16rem] sm:max-w-[18rem]">
        {/* Pages stacked behind the front one, fanned out for depth */}
        <div class="absolute inset-x-8 inset-y-5 rotate-[6deg] rounded-xl border border-line bg-white/70"></div>
        <div class="absolute inset-x-6 inset-y-4 rotate-[3deg] rounded-xl border border-line bg-card shadow-sm"></div>

        {/* Front data page */}
        <div class="absolute inset-x-3 inset-y-2 flex -rotate-2 flex-col overflow-hidden rounded-xl border border-line bg-card shadow-lg">
          <div class="flex items-center gap-2 bg-sand px-4 py-3">
            <svg viewBox="0 0 20 20" class="h-3.5 w-3.5 shrink-0 text-temple-gold">
              <path d={STAR_PATH} fill="currentColor" />
            </svg>
            <span class="h-1.5 w-16 rounded-full bg-white/35"></span>
            <span class="ml-auto h-1.5 w-7 rounded-full bg-temple-gold/80"></span>
          </div>

          <div class="flex gap-3 px-4 pt-4 sm:gap-4">
            <div class="flex h-20 w-16 shrink-0 items-center justify-center rounded-md bg-sand text-temple-gold sm:h-24 sm:w-[4.5rem]">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" class="h-9 w-9 sm:h-10 sm:w-10">
                <circle cx="12" cy="8.5" r="3.2" />
                <path d="M5.5 19.5c0-3.4 2.9-5.5 6.5-5.5s6.5 2.1 6.5 5.5" />
              </svg>
            </div>
            <div class="flex-1 space-y-2.5 pt-1.5">
              <span class="block h-1.5 w-full rounded-full bg-ink/15"></span>
              <span class="block h-1.5 w-3/5 rounded-full bg-ink/10"></span>
              <span class="block h-1.5 w-4/5 rounded-full bg-ink/10"></span>
              <span class="block h-1.5 w-1/2 rounded-full bg-ink/10"></span>
            </div>
          </div>

          {/* Entry blocks, spread to fill the page rather than leaving it half empty */}
          <div class="flex flex-1 flex-col justify-evenly gap-3 px-4 py-4">
            {[0, 1, 2].map((i) => (
              <div class="space-y-2">
                <span class="block h-1.5 w-12 rounded-full bg-maroon/60"></span>
                <span class="block h-1.5 w-11/12 rounded-full bg-ink/[0.09]"></span>
                <span class={`block h-1.5 rounded-full bg-ink/[0.09] ${['w-2/3', 'w-4/5', 'w-1/2'][i]}`}></span>
              </div>
            ))}
          </div>

          <div class="space-y-2 border-t border-dashed border-ink/15 bg-ink/[0.02] px-4 py-3.5">
            <span class="block h-1.5 w-full rounded-full bg-ink/15"></span>
            <span class="block h-1.5 w-5/6 rounded-full bg-ink/15"></span>
          </div>
        </div>

        {/* Ink stamps struck over the page */}
        <div
          class="absolute left-[16%] top-[33%] flex h-20 w-20 -rotate-[14deg] flex-col items-center justify-center gap-1 rounded-full border-2 border-temple-gold/70 bg-white/50 text-maroon/85 sm:h-24 sm:w-24"
          data-reveal="stamp"
          style="--reveal-delay: 420ms"
        >
          <span class="h-[3px] w-7 rounded-full bg-temple-gold/55"></span>
          <svg viewBox="0 0 20 20" class="h-7 w-7 sm:h-8 sm:w-8">
            <path d={STAR_PATH} fill="currentColor" />
          </svg>
          <span class="h-[3px] w-9 rounded-full bg-temple-gold/55"></span>
        </div>

        <div
          class="absolute right-[5%] top-[55%] flex w-28 rotate-[9deg] items-center gap-2.5 rounded-md border-2 border-maroon/55 bg-white/50 px-2.5 py-2 text-maroon/80 sm:w-32"
          data-reveal="stamp"
          style="--reveal-delay: 620ms"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" class="h-5 w-5 shrink-0 sm:h-6 sm:w-6">
            <path d="M4 12.5l5.5 5.5L20 6.5" />
          </svg>
          <span class="flex-1 space-y-1.5">
            <span class="block h-[3px] w-full rounded-full bg-maroon/55"></span>
            <span class="block h-[3px] w-2/3 rounded-full bg-maroon/55"></span>
          </span>
        </div>

        <div
          class="absolute bottom-[16%] left-[33%] flex h-14 w-14 rotate-[18deg] items-center justify-center rounded-full border-2 border-temple-gold/60 bg-white/50 text-maroon/75 sm:h-16 sm:w-16"
          data-reveal="stamp"
          style="--reveal-delay: 800ms"
        >
          <svg viewBox="0 0 20 20" class="h-6 w-6 sm:h-7 sm:w-7">
            <path d={STAR_PATH} fill="currentColor" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</div>
