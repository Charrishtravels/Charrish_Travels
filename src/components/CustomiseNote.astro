---
interface Props {
  heading?: string;
  text?: string;
  /** Chips listing what can be changed; defaults to the general list below. */
  options?: string[];
}

const {
  heading = 'Nothing here is fixed',
  text = "Every package and place on this page is a starting point. Tell us what you'd change and we'll rebuild the trip around you.",
  options,
} = Astro.props;

const DEFAULT_OPTIONS = ['Your dates', 'Number of days', 'Add or drop places', 'Hotel category', 'Your budget', 'Veg / Jain meals', 'Group size', 'Pace for elders & kids'];
const OPTIONS = options ?? DEFAULT_OPTIONS;
---

{/* Tells visitors the listed packages and places can all be changed. */}
<aside class="rounded-2xl border border-dashed border-saffron/50 bg-card p-5 sm:p-6">
  <div class="flex items-start gap-3 sm:gap-4">
    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-saffron text-on-saffron sm:h-11 sm:w-11" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 sm:h-5 sm:w-5">
        <path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6" />
      </svg>
    </span>
    <div>
      <p class="font-brand pt-1 text-xl leading-tight text-earth sm:pt-0 sm:text-2xl">{heading}</p>
      <p class="mt-1 text-xs leading-relaxed text-ink-muted sm:text-sm">{text}</p>
      <ul class="mt-3 flex flex-wrap gap-1.5 sm:mt-4" aria-label="What you can customise">
        {OPTIONS.map((o) => (
          <li class="inline-flex items-center gap-1 rounded-full bg-sand px-2.5 py-1 text-[11px] font-medium text-earth">
            <svg viewBox="0 0 20 20" class="h-3 w-3 text-success" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" clip-rule="evenodd" /></svg>
            {o}
          </li>
        ))}
      </ul>
    </div>
  </div>
</aside>
