---
import { getImage } from 'astro:assets';
import { SITE } from '../consts';
import footerBackground from '../assets/footer-background.jpg';

const footerBackgroundOptimized = await getImage({ src: footerBackground, width: 1600, format: 'webp' });
---

<footer class="relative overflow-hidden text-white">
  <div
    class="absolute inset-0 -z-10 bg-cover bg-fixed"
    style={`background-image: url(${footerBackgroundOptimized.src}); background-position: 40% center;`}
  >
  </div>
  <div class="absolute inset-0 bg-emerald-950/30"></div>

  <div class="relative mx-auto grid max-w-5xl gap-8 px-4 py-12 sm:grid-cols-3 sm:px-6">
    <div>
      <p class="font-brand text-lg uppercase tracking-wide">{SITE.name}</p>
      <p class="mt-2 text-xs text-white">{SITE.tagline}</p>
    </div>

    <div class="text-xs text-white">
      <p class="font-semibold text-white">Contact</p>
      <ul class="mt-3 space-y-2.5">
        <li class="flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 00-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <a href={`tel:${SITE.phone}`} class="hover:underline">{SITE.phone}</a>
        </li>
        <li class="flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
          <a href={`mailto:${SITE.email}`} class="hover:underline">{SITE.email}</a>
        </li>
        <li class="flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
          </svg>
          <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener" class="hover:underline">WhatsApp us</a>
        </li>
        <li class="flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
          <span>{SITE.location}</span>
        </li>
      </ul>
    </div>

    <div class="text-xs text-white">
      <p class="font-semibold text-white">Follow</p>
      <div class="mt-3 flex gap-3">
        <a
          href={SITE.instagram}
          target="_blank"
          rel="noopener"
          aria-label="Instagram"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-white/30 transition-colors hover:bg-white/10"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href={SITE.facebook}
          target="_blank"
          rel="noopener"
          aria-label="Facebook"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-white/30 transition-colors hover:bg-white/10"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
            <path d="M13.5 21v-7.5h2.5l.5-3h-3V8.5c0-.87.24-1.46 1.49-1.46H16.5V4.32C16.24 4.28 15.32 4.2 14.24 4.2c-2.24 0-3.74 1.36-3.74 3.86V10.5H8v3h2.5V21h3z" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="relative border-t border-white/15 px-4 py-4 text-center text-xs text-white sm:px-6">
    &copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.
  </div>
</footer>
