---
import type { CollectionEntry } from 'astro:content';

interface Props {
  destination: CollectionEntry<'destinations'>;
}

const { destination } = Astro.props;
const { title, heroImage } = destination.data;
---

<a
  href={`/destinations/${destination.id}`}
  class="group relative block aspect-[3/4] w-full overflow-hidden rounded-3xl border border-white/10 shadow-lg"
>
  <img
    src={heroImage}
    alt={title}
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/15 to-black/85"></div>
  <div class="relative flex h-full flex-col justify-between p-5">
    <h3 class="font-brand text-xl text-white [text-shadow:0_2px_10px_rgb(0_0_0_/_0.7)]">{title}</h3>
    <p class="text-left text-xs font-semibold uppercase tracking-wide text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100">
      View more →
    </p>
  </div>
</a>
