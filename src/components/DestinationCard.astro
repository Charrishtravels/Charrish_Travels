---
import type { CollectionEntry } from 'astro:content';

interface Props {
  destination: CollectionEntry<'destinations'>;
}

const { destination } = Astro.props;
const { title, summary, heroImage } = destination.data;
---

<a
  href={`/destinations/${destination.id}`}
  class="group relative block aspect-[3/4] w-full overflow-hidden rounded-3xl border border-white/10 shadow-lg"
>
  <img
    src={heroImage}
    alt={title}
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black/70"></div>
  <div class="relative flex h-full flex-col justify-between p-5">
    <h3 class="font-brand text-xl text-white">{title}</h3>
    <p class="text-xs text-white/90">{summary}</p>
  </div>
</a>
